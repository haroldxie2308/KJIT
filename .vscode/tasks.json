{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "KJIT: Prepare",
            "type": "shell",
            "command": "make prepare",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "KJIT: Rust Metadata",
            "type": "shell",
            "command": "make rustavailable-check",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "KJIT: Kernel Prepare",
            "type": "shell",
            "command": "make kernel-prepare",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "KJIT: Kernel Build",
            "type": "shell",
            "command": "make kernel-build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "KJIT: Clean",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "KJIT: Rust Project",
            "type": "shell",
            "command": "make rust-analyzer",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "KJIT: Module Build",
            "type": "shell",
            "command": "make module-build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
