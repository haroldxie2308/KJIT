<mxfile host="app.diagrams.net"><diagram name="page" id="p1"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="960" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="A fragment and one run (drawn in execution order; layout order is prologue, epilogue, body, cold)" style="text;html=0;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=middle;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="900" height="24" as="geometry"/></mxCell><mxCell id="P" value="Prologue  [0, 0xa8)" style="rounded=1;arcSize=3;html=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#666666;fontColor=#222222;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="430" height="150" as="geometry"/></mxCell><mxCell id="c3" value="build the 208-byte runtime frame on the kernel stack&#10;save the kernel callee-saved state (x18..x30)&#10;store x2 (entry address), the dispatch table&#10;pointer (extra[2]) and the budget counter = 4096&#10;load the user registers from pt_regs; br x12 to the entry" style="text;html=0;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="52" y="80" width="406" height="112" as="geometry"/></mxCell><mxCell id="B" value="Body: original blocks, ascending start address" style="rounded=1;arcSize=3;html=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;strokeWidth=1.5;fillColor=#fffaf3;strokeColor=#d79b00;fontColor=#222222;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="430" height="330" as="geometry"/></mxCell><mxCell id="B1" value="user instructions, lowered by reg-virt&#10;LDTR/STTR or PAN-window accesses,&#10;fills and spills of stack-backed registers" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="55" y="275" width="400" height="55" as="geometry"/></mxCell><mxCell id="B2" value="budget check: ldr, sub, str the counter, cbz to&#10;the Budget stub (4 words), before every&#10;back-edge and every dispatch site" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="55" y="340" width="400" height="60" as="geometry"/></mxCell><mxCell id="B3" value="dispatch template (9 words), for BL/BLR/BR/RET:&#10;slot = table[pc[13:2]]; if slot.pc == target&#10;then br x12 to slot.host; else fall through" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="55" y="410" width="400" height="70" as="geometry"/></mxCell><mxCell id="B4" value="exit group (miss path, also Svc and Unsupported):&#10;x9 = status, x10 = target or word, x11 = resume pc;&#10;b epilogue" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="55" y="490" width="400" height="60" as="geometry"/></mxCell><mxCell id="C" value="Cold region: out of line, nothing falls into it" style="rounded=1;arcSize=3;html=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;strokeWidth=1.5;fillColor=#fffaf3;strokeColor=#d79b00;fontColor=#222222;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="430" height="170" as="geometry"/></mxCell><mxCell id="C1" value="Mem stub, one per memory instruction (the fault&#10;fixup lands here): status Mem, x10 = insn word,&#10;x11 = original pc; b epilogue" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="55" y="625" width="400" height="55" as="geometry"/></mxCell><mxCell id="C2" value="Budget stub, one per budget check: status Budget,&#10;x10 = branch word, x11 = its pc;&#10;b epilogue" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="400" height="55" as="geometry"/></mxCell><mxCell id="E" value="Epilogue  [0xa8, body)" style="rounded=1;arcSize=3;html=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;strokeWidth=1.5;fillColor=#fafafa;strokeColor=#666666;fontColor=#222222;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="430" height="120" as="geometry"/></mxCell><mxCell id="c4" value="reload the kernel callee-saved state from frame slots&#10;the body cannot write; write the full user state back&#10;to pt_regs; stp x10, x11 to extra[0..1]&#10;x0 = RetStatus; ret to the trampoline" style="text;html=0;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="52" y="820" width="406" height="84" as="geometry"/></mxCell><mxCell id="R1" value="Runtime (kjit_after_syscall, kjit_call_fragment)&#10;calls the fragment at its base:&#10;x0 = pt_regs, x1 = extra params (x10, x11 out; table in),&#10;x2 = base + entry offset (first entry, or a resume label)" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="560" height="130" as="geometry"/></mxCell><mxCell id="R5" value="Runtime frame, 208 bytes, sp-based (shared/abi/frame.rs)&#10;[16, 80) user-state slots, 80 entry address, 176 pt_regs pointer,&#10;192 budget counter, 200 dispatch table pointer;&#10;kernel slots: only the pt_regs pointer, the budget check and the template's table load read them" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="640" y="215" width="560" height="100" as="geometry"/></mxCell><mxCell id="R2" value="Dispatch table slot (per mm; table_all or table_nofp)&#10;record { pc, host } or 0; only the runtime writes it,&#10;fragment code reads it only through the template" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="640" y="385" width="560" height="70" as="geometry"/></mxCell><mxCell id="R3" value="Another fragment (or this one): runs from that label with&#10;no runtime round trip; every dispatch attempt costs&#10;one unit of the 4096 budget" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="560" height="70" as="geometry"/></mxCell><mxCell id="R4" value="Runtime acts on x0 (status), x10, x11:&#10;Svc: invoke the next syscall in the kernel, re-enter at the resume pc&#10;Bl/Blr/Br/Ret (a miss): publish the label, chain into a fragment&#10;Unsupported, Mem, Budget, or a declined run: return to EL0 at x11,&#10;which re-executes natively" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#666666;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="640" y="790" width="560" height="120" as="geometry"/></mxCell><mxCell id="c5" value="1  call at base" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="R1" target="P"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="2  br x12 to the entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P" target="B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="reads slot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="B3" target="R2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="3  hit: br x12 to host" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="B3" target="R3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;entryX=1;entryY=0.33;" edge="1" parent="1" source="B4" target="E"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="520"/><mxPoint x="500" y="830"/></Array></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;entryX=1;entryY=0.33;" edge="1" parent="1" source="C1" target="E"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="652"/><mxPoint x="500" y="830"/></Array></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;entryX=1;entryY=0.33;" edge="1" parent="1" source="C2" target="E"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="717"/><mxPoint x="500" y="830"/></Array></mxGeometry></mxCell><mxCell id="c12" value="5  return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.54;entryX=0;entryY=0.5;" edge="1" parent="1" source="E" target="R4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="6  next entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="R4" target="R1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="855"/><mxPoint x="1250" y="125"/></Array></mxGeometry></mxCell><mxCell id="c14" value="4  b epilogue" style="text;html=0;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="512" y="585" width="110" height="20" as="geometry"/></mxCell><mxCell id="R6" value="Dispatch miss: an empty slot (cbz) or a different pc (cbnz)&#10;falls into the exit group that follows the template.&#10;The runtime then resolves the target, publishes its label&#10;and may chain, so the next transfer hits" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="640" y="600" width="560" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>