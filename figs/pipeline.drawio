<mxfile host="app.diagrams.net"><diagram name="page" id="p1"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Translation pipeline: A64 to A64, no architecture-neutral IR" style="text;html=0;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="4" width="840" height="22" as="geometry"/></mxCell><mxCell id="in" value="Raw userspace bytes&#10;(CodeProvider, entry PC)" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="36" width="320" height="50" as="geometry"/></mxCell><mxCell id="p0" value="1  Decode&#10;generated A64Insn::decode,&#10;keeps the original PC" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="320" height="64" as="geometry"/></mxCell><mxCell id="n0" value="Subset forms only; is_decode_undefined makes&#10;reserved encodings undecodable.&#10;Generated from Arm XML (specgen)." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="460" height="64" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p0" target="n0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1" value="2  Admit per PC&#10;cfg::admit_at: decode, then&#10;reg_virt::admit_insn" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="210" width="320" height="64" as="geometry"/></mxCell><mxCell id="n1" value="The single decision per PC. A word that is not&#10;admitted ends its block with an Unsupported exit;&#10;userspace runs it natively." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="210" width="460" height="64" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p1" target="n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="3  Build the CFG&#10;reachable blocks from the&#10;entry PC, via a CodeProvider" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="310" width="320" height="64" as="geometry"/></mxCell><mxCell id="n2" value="Blocks partition the PC space; the block order is&#10;ascending start address (layout_block_order).&#10;An unreadable entry is a hard error." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="310" width="460" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p2" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3" value="4  Rephrase&#10;semantic boundary instructions,&#10;still typed A64" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="410" width="320" height="64" as="geometry"/></mxCell><mxCell id="n3" value="Only producer of runtime exits, cold stubs (Mem,&#10;Budget), back-edge budget checks and dispatch sites.&#10;ADR/ADRP become absolute; PRFM, BTI become NOP." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="410" width="460" height="64" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p3" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4" value="5  Register virtualization&#10;RewritePlan::build&#10;(separate structured pass)" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="510" width="320" height="64" as="geometry"/></mxCell><mxCell id="n4" value="x12-x17 stack-backed, x29/sp stable-mapped; user&#10;load/store becomes LDTR/STTR or a PAN window.&#10;Knows nothing about branches or budgets." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="510" width="460" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p4" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5" value="6  Layout&#10;one ExecutionFragment" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="610" width="320" height="64" as="geometry"/></mxCell><mxCell id="n5" value="prologue, epilogue, block bodies, then the cold region;&#10;virtual labels; branch immediates are resolved here&#10;and layout self-checks its invariants." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="610" width="460" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p5" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6" value="7  Emit&#10;bytes via generated&#10;A64Insn::encode()" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="710" width="320" height="64" as="geometry"/></mxCell><mxCell id="n6" value="Fragment bytes plus the fault-site table and the&#10;entry table (every label can be an entry)." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="710" width="460" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p6" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7" value="8  Decode and verify&#10;shared/verify (V3), run on the&#10;emitted bytes again" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="810" width="320" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Independent of the translator (imports only abi, arm64,&#10;platform). The kernel installs only what it accepts and&#10;takes uses_fpsimd from this verdict." style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="810" width="460" height="64" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=none;startArrow=none;strokeWidth=1;" edge="1" parent="1" source="p7" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="in" target="p0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="A64Insn + PC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="admitted insns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="CFG blocks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="rephrased blocks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="virtualized blocks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="ExecutionFragment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="bytes + tables" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out" value="Verified fragment&#10;installed by the kernel, run by the harness" style="rounded=1;arcSize=8;html=0;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="240" y="910" width="320" height="50" as="geometry"/></mxCell><mxCell id="c19" value="accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p7" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="shared/trans&#10;(cfg, rephrase, reg_virt)" style="text;html=0;fontFamily=Helvetica;fontSize=11;align=right;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="124" width="200" height="36" as="geometry"/></mxCell><mxCell id="c21" value="shared/emit" style="text;html=0;fontFamily=Helvetica;fontSize=11;align=right;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="624" width="200" height="36" as="geometry"/></mxCell><mxCell id="c22" value="shared/verify" style="text;html=0;fontFamily=Helvetica;fontSize=11;align=right;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="824" width="200" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>