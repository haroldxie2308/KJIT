#!/bin/sh
# PID 1 of the kjit-guest initramfs (built by scripts/mk-guest-rootfs.sh).
#
# Contract with scripts/guest-run.sh: the host shares one directory over
# virtio-9p with mount tag "hostshare" (qemu-run.sh); it is mounted at /kjit.
# If /kjit/kjit.ko exists it is loaded before and unloaded after the run; a
# load failure skips the run. /kjit/kjit-run.sh runs with /kjit as the working directory. Status
# lines start with "kjit-init:"; the last one before power-off is
# "kjit-init: run exit=<status>". The guest always powers off. For an
# interactive shell, run the command `sh` (stdio is the serial console).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /kjit
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
printf '127.0.0.1\tlocalhost\n' > /etc/hosts
echo kjit-guest > /proc/sys/kernel/hostname
busybox ip link set lo up

power_off() {
    sync
    busybox poweroff -f
}

if ! mount -t 9p -o trans=virtio,version=9p2000.L hostshare /kjit; then
    echo "kjit-init: cannot mount the 9p share hostshare at /kjit"
    power_off
fi
if [ ! -f /kjit/kjit-run.sh ]; then
    echo "kjit-init: /kjit/kjit-run.sh missing"
    power_off
fi

module=0
if [ -f /kjit/kjit.ko ]; then
    if ! insmod /kjit/kjit.ko; then
        echo "kjit-init: insmod kjit.ko FAILED; skipping run"
        power_off
    fi
    echo "kjit-init: insmod kjit.ko ok"
    module=1
fi

(cd /kjit && sh ./kjit-run.sh)
status=$?

if [ "$module" = 1 ]; then
    if rmmod kjit; then
        echo "kjit-init: rmmod kjit ok"
    else
        echo "kjit-init: rmmod kjit FAILED"
        status=1
    fi
fi
echo "kjit-init: run exit=$status"
power_off
