+/* init_mm is not exported: the kernel tables are TTBR1's. */
+static u64 exp_walk(unsigned long addr, int *level)
+{
+	pgd_t *pgdp = (pgd_t *)__va(read_sysreg(ttbr1_el1) & GENMASK_ULL(47, 12)) + pgd_index(addr);
+	p4d_t *p4dp;
+	pud_t *pudp, pud;
+	pmd_t *pmdp, pmd;
+	pte_t *ptep;
+
+	*level = 0;
+	if (pgd_none(pgdp_get(pgdp)))
+		return 0;
+	p4dp = p4d_offset(pgdp, addr);
+	if (p4d_none(p4dp_get(p4dp)))
+		return 0;
+	pudp = pud_offset(p4dp, addr);
+	pud = pudp_get(pudp);
+	if (pud_none(pud))
+		return 0;
+	if (pud_leaf(pud)) {
+		*level = 1;
+		return pud_val(pud);
+	}
+	pmdp = pmd_offset(pudp, addr);
+	pmd = pmdp_get(pmdp);
+	if (pmd_none(pmd))
+		return 0;
+	if (pmd_leaf(pmd)) {
+		*level = 2;
+		return pmd_val(pmd);
+	}
+	ptep = pte_offset_kernel(pmdp, addr);
+	*level = 3;
+	return pte_val(__ptep_get(ptep));
+}
