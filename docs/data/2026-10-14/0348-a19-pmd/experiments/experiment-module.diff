+/*
+ * Per chunk: the vmalloc mapping (level of the first page's descriptor, its
+ * bits) and, for every page, its linear-map alias: the descriptor (valid? RDONLY?) and a
+ * nofault read and a nofault write through the alias. The write stores BRK to the page's last
+ * word, only if no slot covers it (the page holds BRK there), so a write that wrongly succeeds
+ * changes nothing. A control page from the page allocator must be writable (the probe can see a write).
+ */
+static int exp_alias_show(struct seq_file *m, void *unused)
+{
+	struct kjit_arena_chunk *c;
+	struct page *ctl = alloc_page(GFP_KERNEL);
+	u32 brk = AARCH64_BREAK_FAULT, v;
+
+	if (!ctl)
+		return -ENOMEM;
+	seq_printf(m, "control: write %d read %d\n",
+		   (int)kjit_exp_probe_w(page_address(ctl) + 4092, brk),
+		   (int)kjit_exp_probe_r(page_address(ctl) + 4092, &v));
+	__free_page(ctl);
+	mutex_lock(&kjit_arena_lock);
+	list_for_each_entry(c, &kjit_arena_chunks, node) {
+		unsigned int pages = KJIT_ARENA_CHUNK / PAGE_SIZE, i, valid = 0, ro = 0, lm_pte = 0, lm_blk = 0,
+			     rd_ok = 0, rd_fault = 0, wr_ok = 0, wr_fault = 0, wr_skipped = 0;
+		int vl, ll;
+		u64 vd = exp_walk((unsigned long)c->base, &vl);
+
+		for (i = 0; i < pages; i++) {
+			unsigned long va = (unsigned long)c->base + (unsigned long)i * PAGE_SIZE;
+			void *lin = page_address(vmalloc_to_page((void *)va));
+			u64 ld = exp_walk((unsigned long)lin, &ll);
+			unsigned int g = (i * PAGE_SIZE + PAGE_SIZE - 4) / KJIT_ARENA_GRANULE;
+
+			if (ld & PTE_VALID)
+				valid++;
+			if (ld & PTE_RDONLY)
+				ro++;
+			if (ll == 3)
+				lm_pte++;
+			else if (ll == 2)
+				lm_blk++;
+			if (kjit_exp_probe_r(lin + PAGE_SIZE - 4, &v))
+				rd_fault++;
+			else
+				rd_ok++;
+			if (test_bit(g, c->map))
+				wr_skipped++;
+			else if (kjit_exp_probe_w(lin + PAGE_SIZE - 4, brk))
+				wr_fault++;
+			else
+				wr_ok++;
+		}
+		seq_printf(m, "chunk %px pmd %u vm_level %d vm_desc %016llx alias_pages %u alias_pte %u alias_block %u alias_valid %u alias_rdonly %u read_ok %u read_fault %u write_ok %u write_fault %u write_skipped %u\n",
+			   c->base, c->pmd, vl, vd, pages, lm_pte, lm_blk, valid, ro, rd_ok, rd_fault, wr_ok,
+			   wr_fault, wr_skipped);
 	}
+	mutex_unlock(&kjit_arena_lock);
 	return 0;
 }
