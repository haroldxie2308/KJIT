+#!/usr/bin/env python3
+"""EXPERIMENT (exp/ret-cont): hot-path words per request from `attrib` TSVs.
+
+  words.py M0.tsv M2.tsv [--bl-linked 0.99] [--hit 1.0 0.9 0.8] [--requests N]
+
+M0.tsv: `attrib` over the E1 trace with retcont mode 0 (every executed instruction);
+M2.tsv: the same with mode 2 (`--transfers-only` is enough: only BL/BLR/RET rows are used).
+Mode 1 lowers every instruction exactly as mode 0 (checked by --check1 M1.tsv).
+
+Rows' `count` is the dynamic count over the traced request gaps; the E1 trace is 100000
+requests (-c 50, one test), so words per request = sum(count * words) / requests.
+
+What a row executes (hot path):
+- ordinary instruction: all its emitted words (the cold region and exit groups are not
+  emitted into the tsv).
+- BL: budget + dispatch_target + user_synth (link write) [+ ring_push] + link_slot, then
+  the template (dispatch_lookup, the 9 main-probe-hit words) only if the site is not
+  linked: the tool's own totals count the 9 template words for every BL, which
+  overcounts the linked ones (99% in redis); `--bl-linked` is the fraction linked.
+- BLR/BR: budget + dispatch_target + user_synth + dispatch_lookup (9) [+ ring_push for BLR].
+- RET, modes 0/1: budget + dispatch_target + dispatch_lookup (9).
+- RET, mode 2, ring hit: budget (the first check) + dispatch_target + ring_pop.
+  ring miss: that + budget2 + dispatch_lookup (9).
+"""
+import csv
+import sys
+
+BASE = ["user_op", "user_synth", "user_access", "fill", "spill", "helper_other", "budget",
+        "align", "range", "pan_toggle", "window_access", "dispatch_target"]
+
+
+def rows(path):
+    with open(path) as f:
+        r = csv.DictReader(f, delimiter="\t")
+        out = {}
+        for row in r:
+            out[row["pc"]] = row
+    return out
+
+
+def kind(row):
+    t = row["text"].split()[0] if row["text"] else ""
+    if t == "bl":
+        return "bl"
+    if t == "blr":
+        return "blr"
+    if t == "br":
+        return "br"
+    if t == "ret":
+        return "ret"
+    return "other"
+
+
+def words(row, k, mode, bl_linked, hit):
+    g = lambda c: int(row.get(c, 0) or 0)
+    base = sum(g(c) for c in BASE)
+    if k == "other":
+        return base + g("dispatch_lookup") * 0  # no dispatch words on ordinary rows
+    if k == "bl":
+        w = base + g("link_slot") + g("ring_push") + (1 - bl_linked) * g("dispatch_lookup")
+        return w
+    if k in ("blr", "br"):
+        return base + g("dispatch_lookup") + g("ring_push")
+    if k == "ret":
+        if mode < 2:
+            return base + g("dispatch_lookup")
+        hit_path = base + g("ring_pop")
+        miss_path = hit_path + g("budget2") + g("dispatch_lookup")
+        return hit * hit_path + (1 - hit) * miss_path
+    raise SystemExit(k)
+
+
+def main():
+    a = sys.argv[1:]
+    bl_linked = 0.99
+    hits = [1.0, 0.9, 0.8]
+    requests = 100000
+    check1 = None
+    csv_out = None
+    test_name = ""
+    files = []
+    i = 0
+    while i < len(a):
+        if a[i] == "--bl-linked":
+            bl_linked = float(a[i + 1]); i += 2
+        elif a[i] == "--requests":
+            requests = int(a[i + 1]); i += 2
+        elif a[i] == "--check1":
+            check1 = a[i + 1]; i += 2
+        elif a[i] == "--csv":
+            csv_out = a[i + 1]; i += 2
+        elif a[i] == "--test":
+            test_name = a[i + 1]; i += 2
+        elif a[i] == "--hit":
+            hits = []
+            i += 1
+            while i < len(a) and not a[i].startswith("--"):
+                hits.append(float(a[i])); i += 1
+        else:
+            files.append(a[i]); i += 1
+    m0, m2 = rows(files[0]), rows(files[1])
+    counts = {}
+    for pc, row in m0.items():
+        counts[pc] = (int(row["count"]), kind(row))
+
+    def total(mode, hit):
+        t = 0.0
+        per = {"bl": 0.0, "blr": 0.0, "br": 0.0, "ret": 0.0, "other": 0.0}
+        n = {"bl": 0, "blr": 0, "br": 0, "ret": 0, "other": 0}
+        for pc, (cnt, k) in counts.items():
+            row = m0[pc] if (mode < 2 or k in ("other", "br")) else m2[pc]
+            w = words(row, k, mode, bl_linked, hit) * cnt
+            t += w
+            per[k] += w
+            n[k] += cnt
+        return t, per, n
+
+    rows_out = []
+    print(f"requests {requests}  BL linked {bl_linked}")
+    t0, per0, n0 = total(0, 1.0)
+    print(f"dynamic transfers per request: " + ", ".join(f"{k} {n0[k]/requests:.1f}" for k in ("bl", "blr", "br", "ret")))
+    print(f"mode 0/1 words per request {t0/requests:.0f}  (" + ", ".join(f"{k} {per0[k]/requests:.0f}" for k in per0) + ")")
+    for mode in (0, 1):
+        rows_out.append([test_name, mode, "", t0 / requests] + [per0[k] / requests for k in ("bl", "blr", "br", "ret", "other")])
+    for h in hits:
+        t2, per2, _ = total(2, h)
+        print(f"mode 2, ring hit rate {h:.2f}: words per request {t2/requests:.0f}  delta {(t2-t0)/requests:+.0f}  (" +
+              ", ".join(f"{k} {per2[k]/requests:.0f}" for k in per2) + ")")
+        rows_out.append([test_name, 2, h, t2 / requests] + [per2[k] / requests for k in ("bl", "blr", "br", "ret", "other")])
+    # The tool's own total (every emitted word, 9 template words for every site), for the
+    # comparison with the 10-13 15:25 entry.
+    allw = 0
+    for pc, (cnt, k) in counts.items():
+        row = m0[pc]
+        allw += cnt * (sum(int(row.get(c, 0) or 0) for c in BASE) + int(row.get("dispatch_lookup", 0) or 0))
+    if csv_out:
+        with open(csv_out, "w", newline="") as f:
+            w = csv.writer(f)
+            w.writerow(["test", "mode", "ring_hit_rate", "words_per_req", "bl_words_per_req", "blr_words_per_req",
+                        "br_words_per_req", "ret_words_per_req", "other_words_per_req"])
+            for r in rows_out:
+                w.writerow([r[0], r[1], r[2]] + ["%.1f" % x for x in r[3:]])
+    print(f"tool total as in 10-13 15:25 (all template words, no link slots): {allw/requests:.0f} per request")
+    if check1:
+        m1 = rows(check1)
+        lowered = [pc for pc in m1 if kind(m1[pc]) in ("bl", "blr", "ret")]
+        diff = [pc for pc in lowered if any(m1[pc].get(c) != m0[pc].get(c) for c in BASE + ["dispatch_lookup", "link_slot", "ring_push", "ring_pop", "budget2"])]
+        print(f"mode 1 lowering differs from mode 0 on {len(diff)} of {len(lowered)} BL/BLR/RET rows")
+
+
+main()
