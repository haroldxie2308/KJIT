@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# EXPERIMENT (exp/ret-cont): collects the data of the 2026-10-14 ret-cont entry into docs/data/2026-10-14/.
+#   assemble.sh HHMM SCRATCH_DIR
+# SCRATCH_DIR: attrib-out/ (attrib TSVs), the harness test logs (full-m*.log, native-m*.log, m2-mut.log, m*-fix.log).
+set -euo pipefail
+hhmm=$1
+scr=$2
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+runs=${KJIT_BUILD_ROOT:-/Volumes/CaseSentitiveLocal/KJIT/.kjit/build}/runs
+d=$root/docs/data/2026-10-14
+raw=$d/$hhmm-ret-cont
+mkdir -p "$raw/attrib" "$raw/harness"
+for r in "$runs"/ub-rc-rc-k* "$runs"/ub-rc-units-* "$runs"/ub-rc-diag-* "$runs"/ub-rc-push-* "$runs"/ub-rc-gate-* "$runs"/ub-retcont-smoke1; do
+    [[ -d $r ]] || continue
+    n=$(basename "$r")
+    [[ -f $r/host.txt ]] || continue   # a boot that never started
+    mkdir -p "$raw/$n"
+    for f in serial.log host.txt kjit-run.sh; do [[ -f $r/$f ]] && cp "$r/$f" "$raw/$n/"; done
+done
+python3 -I "$root/tools/retcont/summarize.py" --runs "$runs" --tag rc --csv "$d/$hhmm-ret-cont.csv" \
+    --boots-csv "$d/$hhmm-ret-cont-boots.csv" --tables "$raw/tables.md" > /dev/null
+python3 -I "$root/tools/retcont/summarize.py" --runs "$runs" --tag push --csv "$d/$hhmm-ret-cont-push.csv" \
+    --boots-csv "$raw/push-boots.csv" --tables "$raw/tables-push.md" > /dev/null
+if ls "$runs"/ub-rc-units-* > /dev/null 2>&1; then
+    python3 -I "$root/tools/retcont/summarize.py" --runs "$runs" --tag units --csv "$d/$hhmm-ret-cont-units.csv" \
+        --boots-csv "$raw/units-boots.csv" --tables "$raw/tables-units.md" > /dev/null
+fi
+{
+    # The measured ring hit rates (units build: 1 - (units(m2) - units(m1)) / RETs per request).
+    for t in set:0.9214 get:0.9354; do
+        python3 -I "$root/tools/retcont/words.py" "$scr/attrib-out/${t%%:*}-m0.tsv" "$scr/attrib-out/${t%%:*}-m2.tsv" \
+            --check1 "$scr/attrib-out/${t%%:*}-m1.tsv" --test "${t%%:*}" --csv "$raw/words-${t%%:*}.csv" --hit 1.0 0.95 "${t##*:}" 0.9 0.8
+    done
+} > "$raw/words.txt"
+head -1 "$raw/words-set.csv" > "$d/$hhmm-ret-cont-words.csv"
+tail -n +2 -q "$raw"/words-set.csv "$raw"/words-get.csv >> "$d/$hhmm-ret-cont-words.csv"
+rm -f "$raw"/words-set.csv "$raw"/words-get.csv
+# The BL / BLR / RET rows of the attrib TSVs, one file per test and mode.
+for t in set get; do
+    for m in 0 1 2; do
+        awk -F'\t' 'NR == 1 || $7 ~ /^(bl|blr|ret)( |$)/' "$scr/attrib-out/$t-m$m.tsv" > "$raw/attrib/$t-m$m-transfers.tsv"
+    done
+done
+for f in full-m0 full-m1 full-m2 native-m0 native-m1 native-m2 m2-mut; do
+    [[ -f $scr/$f.log ]] && grep -E "^test result|^test .*FAILED|asm fixture suite|^\| ring |^\| random|verifier mutation suite" "$scr/$f.log" | cut -c1-300 > "$raw/harness/$f.txt"
+done
+ls -R "$raw" | head -80
