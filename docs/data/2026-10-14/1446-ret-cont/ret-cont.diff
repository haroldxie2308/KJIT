index 0000000..502d010
--- /dev/null
+++ b/tests/guest/host/quiet-wait.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# EXPERIMENT (exp/ret-cont): polls every 0.1 s until no qemu-system-aarch64 runs and the 1-minute
+# load is <= UB_MAX_LOAD (default 6), takes the host (a placeholder process named
+# qemu-system-aarch64, which every ub-run.sh waits on), runs the command (host/ub-run.sh with
+# UB_NO_WAIT=1) and drops the placeholder as soon as the command's own guest is running.
+# Another agent's ub-run.sh polls every 3 s and found no gap between its back-to-back boots.
+#   quiet-wait.sh COMMAND...
+set -uo pipefail
+max_load="${UB_MAX_LOAD:-6}"
+lock_dir=/tmp/rc-lock
+mkdir -p "$lock_dir"
+ln -sf /bin/sleep "$lock_dir/qemu-system-aarch64"
+start=$(date +%s)
+while true; do
+    n=$({ pgrep -x qemu-system-aarch64 || true; } | wc -l | tr -d ' ')
+    l=$(sysctl -n vm.loadavg | awk '{ print $2 }')
+    if [[ "$n" == 0 ]] && awk -v l="$l" -v m="$max_load" 'BEGIN { exit !(l <= m) }'; then
+        # Take the host before anything else.
+        "$lock_dir/qemu-system-aarch64" 3600 &
+        placeholder=$!
+        sleep 0.2
+        # Someone else's guest started in the same instant: give the host back.
+        if [[ $({ pgrep -x qemu-system-aarch64 || true; } | wc -l | tr -d ' ') -gt 1 ]]; then
+            kill "$placeholder" 2> /dev/null
+            wait "$placeholder" 2> /dev/null
+            continue
+        fi
+        break
+    fi
+    sleep 0.1
+done
+echo "quiet-wait: host taken after $(( $(date +%s) - start )) s (load1 $l)" >&2
+UB_NO_WAIT=1 "$@" &
+cmd=$!
+# The command's guest is up when a qemu-system-aarch64 other than the placeholder exists.
+while kill -0 "$cmd" 2> /dev/null; do
+    others=$({ pgrep -x qemu-system-aarch64 || true; } | grep -v "^$placeholder$" | wc -l | tr -d ' ')
+    [[ "$others" -ge 1 ]] && break
+    sleep 0.1
+done
+kill "$placeholder" 2> /dev/null
+wait "$placeholder" 2> /dev/null
+wait "$cmd"
