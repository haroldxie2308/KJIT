+/// EXPERIMENT (exp/ret-cont) facts: which body words belong to a ring push or pop group.
+struct RingGroups {
+    /// `Some(p)`: word `p` (0..`RING_PUSH_LEN`) of a push group.
+    push: SharedVec<Option<u8>>,
+    /// `Some(p)`: word `p` (0..`RING_POP_LEN`) of a pop group.
+    pop: SharedVec<Option<u8>>,
+}
+
+/// Finds the ring groups (abi `KJIT_RING_PUSH`, `KJIT_RING_POP`).
+///
+/// - Pop: every `br x12` that is word 6 of seven words equal to `KJIT_RING_POP`. Anything
+///   else is left to `find_dispatch_templates` and the main pass (`IndirectBranch`).
+/// - Push: every `adr`. It must be word 2 of five words equal to `KJIT_RING_PUSH` up to
+///   the `adr` immediate, and its target must be an entry offset of the fragment: the
+///   host a push stores is `image + a verified entry offset`. Any other `adr` is
+///   `PcRelative` in the main pass.
+///
+/// Why this is enough (the invariant the pop's `br x12` rests on): the ring is frame
+/// memory below the user-state slots; the frame rule (3) rejects every body access to
+/// it except through x12 inside these groups (`RuntimeAccessBase`), the prologue
+/// (byte-exact) clears it, so a non-zero host word was stored by a push group of this
+/// fragment image, i.e. is `image + entry offset`. The pop branches to it only when its
+/// pc word equals the target T and the host word is non-zero.
+fn find_ring_groups(
+    code: &[u8],
+    body: &[A64Insn],
+    entry_offsets: &[usize],
+) -> Result<RingGroups, VerifyError> {
+    let offset = |index: usize| BODY_OFFSET + index * ABI_INSN_SIZE;
+    let mut groups = RingGroups {
+        push: alloc_positions(body.len())?,
+        pop: alloc_positions(body.len())?,
+    };
+    let body_index = |off: usize| -> Option<usize> {
+        if off < BODY_OFFSET || off >= code.len() || off % ABI_INSN_SIZE != 0 {
+            return None;
+        }
+        Some((off - BODY_OFFSET) / ABI_INSN_SIZE)
+    };
+    let mut is_entry = alloc_bools(body.len())?;
+    for &entry in entry_offsets {
+        if let Some(index) = body_index(entry) {
+            is_entry[index] = true;
+        }
+    }
+    for (index, insn) in body.iter().enumerate() {
+        let reject = err(offset(index), VerifyRule::RingGroup);
+        match insn {
+            A64Insn::BrBr64BranchReg { rn } if rn.enc() == DISPATCH_SLOT_REG => {
+                let Some(start) = (index + 1).checked_sub(RING_POP_LEN) else {
+                    continue;
+                };
+                let mut words = [0_u32; RING_POP_LEN];
+                let mut readable = true;
+                for (position, word) in words.iter_mut().enumerate() {
+                    match read_word(code, offset(start + position)) {
+                        Some(read) => *word = read,
+                        None => readable = false,
+                    }
+                }
+                if !readable || !ring_pop_matches(&words) {
+                    continue;
+                }
+                if groups.pop[start..=index].iter().any(Option::is_some)
+                    || groups.push[start..=index].iter().any(Option::is_some)
+                {
+                    return Err(reject);
+                }
+                for (position, slot) in groups.pop[start..=index].iter_mut().enumerate() {
+                    *slot = Some(position as u8);
+                }
+            }
+            A64Insn::AdrAdrOnlyPcreladdr { rd, .. } if rd.enc() == DISPATCH_KEY_REG => {
+                let Some(start) = index.checked_sub(crate::shared::abi::RING_PUSH_ADR_INDEX) else {
+                    continue;
+                };
+                let mut words = [0_u32; RING_PUSH_LEN];
+                let mut readable = true;
+                for (position, word) in words.iter_mut().enumerate() {
+                    match read_word(code, offset(start + position)) {
+                        Some(read) => *word = read,
+                        None => readable = false,
+                    }
+                }
+                if !readable {
+                    continue;
+                }
+                let Some(delta) = ring_push_matches(&words) else {
+                    continue;
+                };
+                // The stored host is image + the target: an entry offset.
+                usize::try_from(offset(index) as i64 + delta)
+                    .ok()
+                    .and_then(body_index)
+                    .filter(|&target| is_entry[target])
+                    .ok_or(reject)?;
+                if groups.pop[start..start + RING_PUSH_LEN].iter().any(Option::is_some)
+                    || groups.push[start..start + RING_PUSH_LEN].iter().any(Option::is_some)
+                {
+                    return Err(reject);
+                }
+                for (position, slot) in groups.push[start..start + RING_PUSH_LEN].iter_mut().enumerate() {
+                    *slot = Some(position as u8);
+                }
+            }
+            _ => {}
+        }
+    }
+    Ok(groups)
+}
