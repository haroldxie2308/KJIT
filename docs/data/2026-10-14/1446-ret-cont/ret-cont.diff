diff --git a/harness/src/bin/retcont-dump.rs b/harness/src/bin/retcont-dump.rs
new file mode 100644
index 0000000..1c5a2f7
--- /dev/null
+++ b/harness/src/bin/retcont-dump.rs
@@ -0,0 +1,60 @@
+//! EXPERIMENT (exp/ret-cont): `retcont-dump <text-bin> <text-base> <entry-pc>`: translates the
+//! case in `$KJIT_RETCONT` mode, prints every fragment word (offset, word, disassembly,
+//! the labels at it) and the verifier's verdict.
+
+use kjit_harness::a64_forms::disassemble;
+use kjit_harness::shared::trans::input::{TranslationRequest, TranslationTrigger};
+use kjit_harness::shared::trans::translate::compile_request;
+use kjit_harness::{encode_fragment, retcont_from_env, verify_encoded_fragment, MockCodeProvider};
+
+fn num(text: &str) -> u64 {
+    match text.strip_prefix("0x") {
+        Some(hex) => u64::from_str_radix(hex, 16).unwrap(),
+        None => text.parse().unwrap(),
+    }
+}
+
+fn main() {
+    retcont_from_env();
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let [text_bin, text_base, entry_pc] = args.as_slice() else {
+        eprintln!("usage: retcont-dump <text-bin> <text-base> <entry-pc>");
+        std::process::exit(2);
+    };
+    let text = std::fs::read(text_bin).unwrap();
+    let code = MockCodeProvider::new(num(text_base), text);
+    let request = TranslationRequest {
+        entry_pc: num(entry_pc),
+        trigger: TranslationTrigger::Manual,
+        regs: None,
+    };
+    let fragment = compile_request(&request, &code).unwrap_or_else(|err| {
+        eprintln!("compile: {err}");
+        std::process::exit(1);
+    });
+    let bytes = encode_fragment(&fragment).unwrap();
+    let words: Vec<u32> = bytes
+        .chunks(4)
+        .map(|c| u32::from_le_bytes(c.try_into().unwrap()))
+        .collect();
+    let text = disassemble(&words).unwrap();
+    for (index, word) in words.iter().enumerate() {
+        let offset = index * 4;
+        let labels: Vec<String> = fragment
+            .vlabels
+            .iter()
+            .filter(|&&(_, o)| o == offset)
+            .map(|&(pc, _)| format!("L{pc:#x}"))
+            .collect();
+        println!(
+            "{offset:#06x}  {word:08x}  {:<40} {}",
+            text[index].clone().unwrap_or_else(|| "?".into()),
+            labels.join(" ")
+        );
+    }
+    println!("entry_offset={:#x} len={:#x}", fragment.entry_offset, bytes.len());
+    match verify_encoded_fragment(&fragment, &bytes) {
+        Ok(ok) => println!("verify: ok {ok:?}"),
+        Err(err) => println!("verify: REJECTED at {:#x}: {:?}", err.offset, err.rule),
+    }
+}
