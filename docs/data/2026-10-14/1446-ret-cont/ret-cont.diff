+/// Rules 3 and 9 for one word of a ring push group, whose bytes `find_ring_groups`
+/// proved exact (so the accesses are the group's: one `stp` of x30 and the host into the
+/// ring entry x12 points at, x12 = sp + 16 * (a 4-bit index)). Kernel values: x12 holds a
+/// frame address from word 1 on (the one scratch register a join point may hold one in),
+/// x14 the host from word 2 to word 3 and is zero after word 4, so the group leaves only
+/// x12 kernel-valued. It reads user values: x17 (the mapped user sp) must not be a
+/// kernel value, and x30 is stored (a user value; storing a kernel one would only
+/// change which pc the ring holds).
+fn step_ring_push(position: u8, state: Taint, offset: usize) -> Result<Taint, VerifyError> {
+    const SP: u32 = 1 << REG_VIRT_STABLE_MAPPED_SP_PHYS_REG;
+    const SLOT: u32 = 1 << DISPATCH_SLOT_REG;
+    const KEY: u32 = 1 << DISPATCH_KEY_REG;
+    let mut next = state;
+    match position {
+        0 => {
+            if state.kernel & SP != 0 {
+                return Err(err(offset, VerifyRule::KernelValueRead));
+            }
+            next.kernel &= !KEY;
+            next.pt_regs &= !KEY;
+        }
+        1 => {
+            next.kernel |= SLOT;
+            next.pt_regs &= !SLOT;
+        }
+        2 => {
+            next.kernel |= KEY;
+            next.pt_regs &= !KEY;
+        }
+        3 => {}
+        4 => {
+            next.kernel &= !KEY;
+            next.pt_regs &= !KEY;
+        }
+        _ => return Err(err(offset, VerifyRule::RingGroup)),
+    }
+    Ok(next)
+}
+
+/// Rules 3 and 9 for one word of a ring pop group (bytes proved exact). x17 must not be a
+/// kernel value (word 0), T (x13) must not (word 3). After word 1 x12 is a frame address,
+/// after word 2 x12 is the host (kernel) and x14 the entry's pc (a user value, or 0). The
+/// two miss branches and the `br x12` are control edges that carry only x12 as a kernel
+/// value, which every join point assumes; after the `br` only a join point (the miss
+/// edges' target) reaches the next word.
+fn step_ring_pop(
+    position: u8,
+    state: Taint,
+    join_state: Taint,
+    offset: usize,
+) -> Result<Taint, VerifyError> {
+    const SP: u32 = 1 << REG_VIRT_STABLE_MAPPED_SP_PHYS_REG;
+    const SLOT: u32 = 1 << DISPATCH_SLOT_REG;
+    const KEY: u32 = 1 << DISPATCH_KEY_REG;
+    const TARGET: u32 = 1 << DISPATCH_TARGET_REG;
+    let mut next = state;
+    match position {
+        0 => {
+            if state.kernel & SP != 0 {
+                return Err(err(offset, VerifyRule::KernelValueRead));
+            }
+            next.kernel &= !KEY;
+            next.pt_regs &= !KEY;
+        }
+        1 => {
+            next.kernel |= SLOT;
+            next.pt_regs &= !SLOT;
+        }
+        2 => {
+            next.kernel = (next.kernel & !KEY) | SLOT;
+            next.pt_regs &= !(KEY | SLOT);
+        }
+        3 => {
+            if state.kernel & TARGET != 0 {
+                return Err(err(offset, VerifyRule::KernelValueRead));
+            }
+        }
+        4..=6 => {
+            check_edge(state, join_state, offset)?;
+            if position == 6 {
+                next = join_state;
+            }
+        }
+        _ => return Err(err(offset, VerifyRule::RingGroup)),
+    }
+    Ok(next)
+}
