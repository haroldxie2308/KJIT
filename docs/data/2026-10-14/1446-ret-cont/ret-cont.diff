+//! EXPERIMENT (exp/ret-cont), not for main: the switch of the return-continuation
+//! experiment.
+//!
+//! - `MODE_OFF` (0): today's translation. A `BL`/`BLR` ends its block with no
+//!   successor; the code after the call is translated by whoever enters it.
+//! - `MODE_CONT` (1): (1) return continuations. The CFG follows a `BL`/`BLR`'s resume
+//!   pc into the same fragment (as it does an `SVC`'s). The continuation is a block
+//!   reached only by a return; like every body PC it is an entry label.
+//! - `MODE_RING` (2): (1) plus (2), the shadow return ring in the runtime frame: a
+//!   `BL`/`BLR` pushes (resume pc, host address of the continuation label), a `RET`
+//!   compares its target with the ring slot of the user sp and branches to the
+//!   cached host on a match.
+//! - `MODE_PUSH` (3): (1) plus the pushes of (2) and no pop: the cost of the pushes
+//!   alone (an ablation; the ring is written and never read).
+//!
+//! The mode is read at translation time only (cfg, rephrase); the verifier accepts
+//! the ring constructs whatever the mode is. The kernel module sets it through
+//! debugfs (kjit_glue.c, with KJIT disabled, flushing every fragment). Tests set it
+//! per thread (`with_mode`), defaulting to `$KJIT_RETCONT`.
+
+pub const MODE_OFF: u8 = 0;
+pub const MODE_CONT: u8 = 1;
+pub const MODE_RING: u8 = 2;
+pub const MODE_PUSH: u8 = 3;
+
+#[cfg(not(test))]
+mod imp {
+    use core::sync::atomic::{AtomicU8, Ordering};
+
+    static MODE: AtomicU8 = AtomicU8::new(super::MODE_OFF);
+
+    pub fn mode() -> u8 {
+        MODE.load(Ordering::Relaxed)
+    }
+
+    pub fn set_mode(mode: u8) {
+        MODE.store(mode, Ordering::Relaxed);
+    }
+}
+
+#[cfg(test)]
+mod imp {
+    use std::cell::Cell;
+    use std::sync::OnceLock;
+
+    thread_local! {
+        static OVERRIDE: Cell<Option<u8>> = const { Cell::new(None) };
+    }
+
+    fn env_mode() -> u8 {
+        static ENV: OnceLock<u8> = OnceLock::new();
+        *ENV.get_or_init(|| match std::env::var("KJIT_RETCONT") {
+            Ok(value) => value
+                .parse::<u8>()
+                .ok()
+                .filter(|mode| *mode <= super::MODE_PUSH)
+                .unwrap_or_else(|| panic!("KJIT_RETCONT must be 0, 1, 2 or 3, not {value:?}")),
+            Err(_) => super::MODE_OFF,
+        })
+    }
+
+    pub fn mode() -> u8 {
+        OVERRIDE.with(|cell| cell.get()).unwrap_or_else(env_mode)
+    }
+
+    pub fn set_mode(mode: u8) {
+        OVERRIDE.with(|cell| cell.set(Some(mode)));
+    }
+}
+
+pub use imp::{mode, set_mode};
+
+/// Run `f` with the translation mode set to `mode` on this thread (tests).
+#[cfg(test)]
+pub fn with_mode<R>(mode: u8, f: impl FnOnce() -> R) -> R {
+    let previous = imp::mode();
+    imp::set_mode(mode);
+    let result = f();
+    imp::set_mode(previous);
+    result
+}
+
+/// (1): follow a call's resume pc into the same fragment.
+pub fn continuations() -> bool {
+    mode() >= MODE_CONT
+}
+
+/// (2): the ring pushes of a call.
+pub fn ring_push() -> bool {
+    matches!(mode(), MODE_RING | MODE_PUSH)
+}
+
+/// (2): the ring pop of a return.
+pub fn ring_pop() -> bool {
+    mode() == MODE_RING
+}
