+#!/usr/bin/env bash
+# EXPERIMENT (exp/ret-cont), host driver of tests/guest/retcont-sweep.sh (from exp/win-map's
+# host/cond-sweep.sh): BOOTS boots of one kernel setting, each running the cells of
+# $RC_CELLS with the four states paired inside the boot.
+#
+#   host/retcont-sweep.sh TAG NAME:PROFILE:KERNEL_ARGS BOOTS REPS
+#
+# Environment: RC_CELLS (space-separated NAME:SRV:TEST:N:C:P:D:THR:SCPUS:CCPUS:XPORT cells,
+# required), RC_FIRST (number of the first boot, default 1), UB_MODULE (the experiment kjit.ko),
+# UB_TIMEOUT (default 2700), KJIT_BUILD_ROOT, QEMU_SSH_PORT, QEMU_GDB_PORT as host/ub-run.sh.
+# rodata=off is always added (kpti=1 does not boot without it). Boot label
+# rc-TAG-NAME-b<boot>, run directory $KJIT_BUILD_ROOT/runs/ub-<label>. The cells of one server
+# profile stay together; the cells of a block are rotated by the boot number and the blocks
+# alternate.
+set -euo pipefail
+
+[[ $# -eq 4 ]] || { echo "usage: retcont-sweep.sh TAG NAME:PROFILE:ARGS BOOTS REPS" >&2; exit 2; }
+tag=$1
+IFS=: read -r sname sprofile sargs <<< "$2"
+boots=$3
+reps=$4
+
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+build_root="${KJIT_BUILD_ROOT:?set KJIT_BUILD_ROOT}"
+first="${RC_FIRST:-1}"
+export UB_TIMEOUT="${UB_TIMEOUT:-2700}"
+read -r -a cells <<< "${RC_CELLS:?set RC_CELLS}"
+
+rotate_cells() { # BOOT -> echoes the cells in this boot's order
+    local b=$1 i n srv cur="" blocks=() block=() order=() k off
+    n=${#cells[@]}
+    for ((i = 0; i < n; i++)); do
+        srv=$(cut -d: -f2 <<< "${cells[$i]}")
+        if [[ "$srv" != "$cur" ]]; then
+            [[ -z "$cur" ]] || blocks+=("${block[*]}")
+            block=()
+            cur=$srv
+        fi
+        block+=("${cells[$i]}")
+    done
+    blocks+=("${block[*]}")
+    local nb=${#blocks[@]}
+    for ((k = 0; k < nb; k++)); do
+        local bi=$(( (k + b - 1) % nb ))
+        read -r -a block <<< "${blocks[$bi]}"
+        off=$(( ((b - 1) * 5) % ${#block[@]} ))
+        for ((i = 0; i < ${#block[@]}; i++)); do
+            order+=("${block[$(( (i + off) % ${#block[@]} ))]}")
+        done
+    done
+    echo "${order[*]}"
+}
+
+for ((b = first; b < first + boots; b++)); do
+    label="rc-$tag-$sname-b$b"
+    run_dir="$build_root/runs/ub-$label"
+    mkdir -p "$run_dir"
+    cp "$here/../retcont-sweep.sh" "$here/../cond-info.sh" "$run_dir/"
+    order=$(rotate_cells "$b")
+    echo "retcont-sweep: boot $label ($(date '+%H:%M:%S')) profile=$sprofile args='$sargs'"
+    GUEST_PROFILE="$sprofile" UB_APPEND_EXTRA="rodata=off $sargs" "$here/quiet-wait.sh" "$here/ub-run.sh" "$label" 0 "sh /kjit/cond-info.sh 5; RC_STATES='${RC_STATES:-off m0 m1 m2}' sh /kjit/retcont-sweep.sh /tmp/cond $reps $order"
+done
+echo "retcont-sweep: done"
