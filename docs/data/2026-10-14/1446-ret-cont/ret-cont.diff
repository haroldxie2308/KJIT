+#!/usr/bin/env bash
+# EXPERIMENT (exp/ret-cont): the push-only ablation. KPTI-forced-on boots of the states
+# m0, m1, m2, m3 (m3 = continuations and the ring pushes, no pop) paired inside each boot,
+# on the module of mod-retcont3.   drive-push.sh FIRST LAST REPS
+set -uo pipefail
+WT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+export KJIT_BUILD_ROOT=${KJIT_BUILD_ROOT:-/Volumes/CaseSentitiveLocal/KJIT/.kjit/build}
+export QEMU_SSH_PORT=${QEMU_SSH_PORT:-12922} QEMU_GDB_PORT=${QEMU_GDB_PORT:-2352}
+export UB_MODULE=${UB_MODULE:-$KJIT_BUILD_ROOT/mod-retcont3/kjit.ko}
+export UB_TIMEOUT=${UB_TIMEOUT:-2400} UB_MAX_LOAD=${UB_MAX_LOAD:-6}
+export RC_STATES="m0 m1 m2 m3"
+CELLS="set_c50_p1_d1:base:set:1000000:50:1:1:2:0:1-3:tcp get_c50_p1_d1:base:get:1000000:50:1:1:2:0:1-3:tcp
+unix_get_c50_p1_d1:unix:get:1000000:50:1:1:2:0:1-3:unix unix_set_c50_p1_d1:unix:set:1000000:50:1:1:2:0:1-3:unix
+unix_pingm_c50_p1:unix:ping_mbulk:1000000:50:1:1:2:0:1-3:unix"
+for ((b = $1; b <= $2; b++)); do
+  RC_FIRST=$b RC_CELLS=$(echo $CELLS) "$WT/tests/guest/host/retcont-sweep.sh" push "k1:kjit-guest:kpti=1" 1 "$3"
+  echo "DRIVE: rc-push-k1-b$b status=$? $(date '+%H:%M:%S')"
+done
+echo "DRIVE: all done $(date '+%H:%M:%S')"
