+++ b/tools/retcont/drive.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+# EXPERIMENT (exp/ret-cont): interleaved k1 (KPTI forced on) / k0 (KPTI off) boots of
+# tests/guest/host/retcont-sweep.sh, the four states paired inside each boot.
+#   drive.sh K1_FIRST K1_LAST K0_FIRST K0_LAST REPS
+# Boot order: k1 b<first>, k0 b<first>, k1 b<first+1>, ... A boot that fails is logged and the
+# drive goes on (re-run it by number later). Environment: UB_MODULE (default mod-retcont).
+set -uo pipefail
+WT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+export KJIT_BUILD_ROOT=${KJIT_BUILD_ROOT:-/Volumes/CaseSentitiveLocal/KJIT/.kjit/build}
+export QEMU_SSH_PORT=${QEMU_SSH_PORT:-12922} QEMU_GDB_PORT=${QEMU_GDB_PORT:-2352}
+export UB_MODULE=${UB_MODULE:-$KJIT_BUILD_ROOT/mod-retcont/kjit.ko}
+export UB_TIMEOUT=${UB_TIMEOUT:-2400}
+export UB_MAX_LOAD=${UB_MAX_LOAD:-6}
+reps=$5
+TAG=${RC_TAG:-rc}
+# NAME:SRV:TEST:N:C:P:D:THR:SCPUS:CCPUS:XPORT
+K1_CELLS="set_c50_p1_d1:base:set:1000000:50:1:1:2:0:1-3:tcp get_c50_p1_d1:base:get:1000000:50:1:1:2:0:1-3:tcp
+pingm_c50_p1:base:ping_mbulk:1000000:50:1:1:2:0:1-3:tcp
+unix_get_c50_p1_d1:unix:get:1000000:50:1:1:2:0:1-3:unix unix_set_c50_p1_d1:unix:set:1000000:50:1:1:2:0:1-3:unix
+unix_pingm_c50_p1:unix:ping_mbulk:1000000:50:1:1:2:0:1-3:unix"
+K0_CELLS="unix_get_c50_p1_d1:unix:get:1000000:50:1:1:2:0:1-3:unix unix_set_c50_p1_d1:unix:set:1000000:50:1:1:2:0:1-3:unix"
+run() { # NAME BOOT ARGS CELLS
+  local name=$1 b=$2 args=$3 cells=$4 label=rc-$TAG-$1-b$2 log
+  RC_FIRST=$b RC_CELLS=$(echo $cells) "$WT/tests/guest/host/retcont-sweep.sh" "$TAG" "$name:kjit-guest:$args" 1 "$reps"
+  local st=$?
+  log=$KJIT_BUILD_ROOT/runs/ub-$label/serial.log
+  local n; n=$(grep -c 'kernel page table isolation forced ON' "$log" 2>/dev/null)
+  if [[ $name == k1 ]]; then [[ ${n:-0} -gt 0 ]] || { echo "DRIVE: $label KPTI not forced on"; st=99; }
+  else [[ ${n:-0} -eq 0 ]] || { echo "DRIVE: $label KPTI unexpectedly on"; st=98; }; fi
+  grep -q '^cond: done' "$log" 2>/dev/null || { echo "DRIVE: $label did not finish"; st=97; }
+  echo "DRIVE: $label status=$st $(date '+%H:%M:%S') $(grep -h 'load1_before' $KJIT_BUILD_ROOT/runs/ub-$label/host.txt)"
+}
+b1=$1; e1=$2; b0=$3; e0=$4
+n=$(( e1-b1 > e0-b0 ? e1-b1 : e0-b0 ))
+for ((i=0;i<=n;i++)); do
+  (( b1+i <= e1 )) && run k1 $((b1+i)) kpti=1 "$K1_CELLS"
+  (( b0+i <= e0 )) && run k0 $((b0+i)) "" "$K0_CELLS"
+done
+echo "DRIVE: all done $(date '+%H:%M:%S')"
diff --git a/tools/retcont/summarize.py b/tools/retcont/summarize.py
new file mode 100644
index 0000000..2371584
--- /dev/null
+++ b/tools/retcont/summarize.py
@@ -0,0 +1,232 @@
+#!/usr/bin/env python3
+"""EXPERIMENT (exp/ret-cont): paired server CPU per request of the four states off, m0, m1, m2.
+
+  summarize.py --runs RUNS_DIR --tag TAG [--csv OUT] [--boots-csv OUT] [--tables OUT]
+
+Reads RUNS_DIR/ub-rc-<TAG>-k<0|1>-b<N>/{serial.log,host.txt} (tests/guest/host/retcont-sweep.sh
+boots; the guest script is tests/guest/retcont-sweep.sh). Metric: server CPU per request =
+sum over the server's tasks of se.sum_exec_runtime (sched_ms) * 1000 / n, us.
+
+States: off = KJIT disabled; m0 = today's translation in the experiment module; m1 = return
+continuations; m2 = continuations and the shadow return ring. A pair = two states in one
+boot, cell and rep (all four run within about 15 s of each other, the order rotated by rep).
+Compared: m0 - off, m1 - m0, m2 - m0, m2 - m1 and m1 - off, m2 - off (us per request).
+Per cell: median [Q1..Q3] over pairs; boots+ = boots whose median pair gap is positive;
+CI = 95% percentile interval of the median pair gap from a cluster bootstrap (resample the
+boots, then the pairs inside each; 5000 draws, seed 1); verdict win = CI upper < 0, tie = CI
+contains 0, lose = CI lower > 0.
+"""
+import argparse
+import csv
+import glob
+import os
+import random
+import re
+import statistics
+import sys
+from collections import defaultdict
+
+KV = re.compile(r"(\w+)=(\S+)")
+STATES = ["off", "m0", "m1", "m2", "m3"]
+COUNTERS = ["hook_calls", "syscalls_in_kernel", "fragment_entries", "chains", "exit_svc", "exit_bl", "exit_blr",
+            "exit_br", "exit_ret", "exit_mem", "exit_unsupported", "exit_budget", "run_declined", "svc_declined",
+            "fpsimd_entries", "translate_ok", "translate_exists", "translate_text_unreadable",
+            "translate_compile_failed", "translate_verify_rejected", "translate_capped", "invalidated_fragments",
+            "ret_label", "ibtc_insert", "ibtc_miss_cold", "ibtc_miss_conflict", "ibtc_miss_other", "ibtc_fpsimd_boundary",
+            "chain_cap", "link_made", "link_restored", "budget_units"]
+COMPARE_ALL = [("m0", "off"), ("m1", "off"), ("m2", "off"), ("m1", "m0"), ("m2", "m0"), ("m2", "m1"),
+               ("m3", "m0"), ("m3", "m1"), ("m2", "m3")]
+
+
+def quart(xs):
+    xs = sorted(xs)
+    if len(xs) < 2:
+        return xs[0], xs[0], xs[0]
+    q = statistics.quantiles(xs, n=4, method="inclusive")
+    return q[0], statistics.median(xs), q[2]
+
+
+def parse(runs_dir, tag):
+    rows, boots = [], {}
+    pat = re.compile(r"^ub-rc-%s-(k[01])-b(\d+)$" % re.escape(tag))
+    for d in sorted(glob.glob(os.path.join(runs_dir, "ub-rc-%s-*" % tag))):
+        m = pat.match(os.path.basename(d))
+        if not m:
+            continue
+        setting, boot = m.group(1), int(m.group(2))
+        label = "%s-b%d" % (setting, boot)
+        if not os.path.exists(os.path.join(d, "host.txt")):
+            continue  # a boot still waiting for the host
+        host = open(os.path.join(d, "host.txt")).read()
+        mm = re.search(r"waited_s=(\d+) load1_before=([\d.]+)", host)
+        waited, load = int(mm.group(1)), float(mm.group(2))
+        la = re.search(r"load1_after=([\d.]+)", host)
+        append = re.search(r"^append=(.*)$", host, re.M).group(1)
+        n_run, done, forced = 0, False, 0
+        for line in open(os.path.join(d, "serial.log"), errors="replace"):
+            line = line.rstrip("\r\n")
+            if "kernel page table isolation forced ON" in line:
+                forced += 1
+            if line.startswith("cond run "):
+                kv = dict(KV.findall(line))
+                kv.update(setting=setting, boot=boot, label=label, load1_before=load, waited_s=waited)
+                rows.append(kv)
+                n_run += 1
+            elif line.startswith("cond: done"):
+                done = True
+        boots[label] = dict(setting=setting, boot=boot, kernel_append=append, kpti_forced_on_lines=forced,
+                            host_waited_s=waited, host_load1_before=load, host_load1_after=la.group(1) if la else "",
+                            runs=n_run, finished=int(done))
+    return rows, boots
+
+
+def derive(r):
+    n = int(r["n"])
+    r["kpti"] = 1 if r["setting"] == "k1" else 0
+    r["cpu_us_per_req"] = float(r["sched_ms"]) * 1000.0 / n
+    for c in COUNTERS:
+        r[c + "_per_req"] = int(r[c]) / n if c in r else float("nan")
+    r["blocks_per_kreq"] = int(r["nvol"]) * 1000.0 / n
+    r["frags_live_i"] = int(r["frags_live"])
+    r["code_live_i"] = int(r["code_live"])
+
+
+def paired(rows):
+    by = defaultdict(dict)
+    for r in rows:
+        by[(r["kpti"], r["cell"], r["label"], r["rep"])][r["state"]] = r
+    return by
+
+
+def cluster_ci(items, draws=5000, seed=1):
+    """items: [(boot, gap)]"""
+    byb = defaultdict(list)
+    for b, g in items:
+        byb[b].append(g)
+    labs = list(byb)
+    rnd = random.Random(seed)
+    meds = []
+    for _ in range(draws):
+        pool = []
+        for _ in labs:
+            v = byb[rnd.choice(labs)]
+            pool.extend(rnd.choice(v) for _ in v)
+        meds.append(statistics.median(pool))
+    meds.sort()
+    return meds[int(0.025 * draws)], meds[int(0.975 * draws) - 1]
+
+
+def gap_stats(by, kpti, cell, a, b):
+    items = [(lab, st[a]["cpu_us_per_req"] - st[b]["cpu_us_per_req"])
+             for (k, c, lab, rep), st in sorted(by.items()) if k == kpti and c == cell and a in st and b in st]
+    if not items:
+        return None
+    gaps = [g for _, g in items]
+    byb = defaultdict(list)
+    for lab, g in items:
+        byb[lab].append(g)
+    bmed = {k: statistics.median(v) for k, v in byb.items()}
+    q1, med, q3 = quart(gaps)
+    lo, hi = cluster_ci(items)
+    return dict(pairs=len(gaps), boots=len(bmed), boots_pos=sum(1 for v in bmed.values() if v > 0),
+                neg=sum(1 for g in gaps if g < 0), med=med, q1=q1, q3=q3, lo=lo, hi=hi,
+                verdict="win" if hi < 0 else ("lose" if lo > 0 else "tie"), bmed=bmed)
+
+
+def med_of(rows, state, key):
+    xs = [r[key] for r in rows if r["state"] == state]
+    return statistics.median(xs) if xs else float("nan")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--runs", required=True)
+    ap.add_argument("--tag", required=True)
+    ap.add_argument("--csv")
+    ap.add_argument("--boots-csv")
+    ap.add_argument("--tables")
+    a = ap.parse_args()
+    rows, boots = parse(a.runs, a.tag)
+    for r in rows:
+        derive(r)
+    for b in boots.values():
+        if not b["finished"]:
+            print("WARNING: boot %s%d did not finish" % (b["setting"], b["boot"]), file=sys.stderr)
+    if a.csv:
+        cols = (["label", "boot", "kpti", "cell", "srv", "test", "n", "c", "p", "d", "thr", "rep", "order", "state", "rps",
+                 "wall_cs", "cpu_us_per_req", "sched_ms", "ticks_u", "ticks_s", "nvol", "ninv", "c0_busy", "c0_idle",
+                 "ipi_c0", "ipi_other", "frags_live", "code_live", "load1_before", "waited_s"] + COUNTERS)
+        names = {"label": "boot_label", "state": "kjit_state", "srv": "server_profile", "n": "requests", "c": "clients",
+                 "p": "pipeline", "d": "value_bytes", "thr": "benchmark_threads", "rps": "req_per_s",
+                 "sched_ms": "sched_exec_ms", "ticks_u": "utime_ticks", "ticks_s": "stime_ticks",
+                 "nvol": "voluntary_switches", "ninv": "involuntary_switches", "c0_busy": "cpu0_busy_ticks",
+                 "c0_idle": "cpu0_idle_ticks", "ipi_c0": "ipi_cpu0", "ipi_other": "ipi_cpus1_3",
+                 "frags_live": "fragments_live_after", "code_live": "code_bytes_live_after",
+                 "load1_before": "host_load1_before", "waited_s": "host_waited_s", "order": "rep_order",
+                 "cpu_us_per_req": "server_cpu_us_per_req"}
+        with open(a.csv, "w", newline="") as f:
+            w = csv.writer(f)
+            w.writerow([names.get(c, c) for c in cols])
+            for r in rows:
+                w.writerow([("%.5f" % r[c]) if isinstance(r.get(c), float) else r.get(c, "") for c in cols])
+    if a.boots_csv:
+        with open(a.boots_csv, "w", newline="") as f:
+            w = csv.writer(f)
+            w.writerow(["boot_label", "kpti", "kernel_append", "kpti_forced_on_lines", "host_waited_s", "host_load1_before",
+                        "host_load1_after", "runs", "finished"])
+            for lab, b in sorted(boots.items()):
+                w.writerow([lab, 1 if b["setting"] == "k1" else 0, b["kernel_append"], b["kpti_forced_on_lines"],
+                            b["host_waited_s"], b["host_load1_before"], b["host_load1_after"], b["runs"], b["finished"]])
+    by = paired(rows)
+    present = {r["state"] for r in rows}
+    COMPARE = [(x, y) for x, y in COMPARE_ALL if x in present and y in present]
+    states = [st for st in STATES if st in present]
+    cells = sorted({(k, c) for (k, c, _, _) in by})
+    out = ["### Boots\n", "| boot | kernel append | KPTI forced-ON lines | host load1 before | host wait (s) | runs |",
+           "|---|---|---|---|---|---|"]
+    for lab, b in sorted(boots.items(), key=lambda kv: (kv[1]["setting"], kv[1]["boot"])):
+        out.append("| %s | `%s` | %d | %.2f | %d | %d |" % (lab, b["kernel_append"].replace("console=ttyAMA0 panic=-1 nokaslr ", ""),
+                                                          b["kpti_forced_on_lines"], b["host_load1_before"], b["host_waited_s"], b["runs"]))
+    for kpti in (1, 0):
+        sel = [c for k, c in cells if k == kpti]
+        if not sel:
+            continue
+        out.append("\n### KPTI %s: server CPU per request, us (median over runs)\n" % ("forced on" if kpti else "off"))
+        out.append("| cell | runs/state | " + " | ".join(states) + " | frags m0 / m1 / m2 | code KB m0 / m1 / m2 | exit_ret/req m0 / m1 / m2 | ret_label/req m1 / m2 |")
+        out.append("|---|---|" + "---|" * len(states) + "---|---|---|---|")
+        for c in sel:
+            rr = [r for r in rows if r["kpti"] == kpti and r["cell"] == c]
+            nruns = {s_: sum(1 for r in rr if r["state"] == s_) for s_ in states}
+            f3 = lambda key, scale=1.0: " / ".join("%.0f" % (med_of(rr, s_, key) / scale) if s_ in present else "-" for s_ in ("m0", "m1", "m2"))
+            out.append("| %s | %s | %s | %s | %s | %s | %s |" % (
+                c, "/".join(str(nruns[s_]) for s_ in states),
+                " | ".join("%.3f" % med_of(rr, s_, "cpu_us_per_req") for s_ in states),
+                f3("frags_live_i"), f3("code_live_i", 1024),
+                " / ".join("%.4f" % med_of(rr, s_, "exit_ret_per_req") for s_ in ("m0", "m1", "m2")),
+                "%.4f / %.4f" % (med_of(rr, "m1", "ret_label_per_req"), med_of(rr, "m2", "ret_label_per_req"))))
+        out.append("\n### KPTI %s: paired gaps, us per request: median [Q1..Q3], 95%% CI, boots+/boots, pairs<0\n" % ("forced on" if kpti else "off"))
+        out.append("| cell | " + " | ".join("%s - %s" % p for p in COMPARE) + " |")
+        out.append("|---|" + "---|" * len(COMPARE))
+        for c in sel:
+            cellout = []
+            for x, y in COMPARE:
+                g = gap_stats(by, kpti, c, x, y)
+                if g is None:
+                    cellout.append("")
+                    continue
+                cellout.append("%+.3f [%+.3f..%+.3f] CI [%+.3f..%+.3f] %s (%d/%d, %d/%d<0)" % (
+                    g["med"], g["q1"], g["q3"], g["lo"], g["hi"], g["verdict"], g["boots_pos"], g["boots"], g["neg"], g["pairs"]))
+            out.append("| %s | %s |" % (c, " | ".join(cellout)))
+        pooled = []
+        for x, y in COMPARE:
+            meds = [g["med"] for g in (gap_stats(by, kpti, c, x, y) for c in sel) if g]
+            pooled.append("%+.3f (mean of %d cell medians; %d positive)" % (statistics.mean(meds), len(meds),
+                                                                          sum(1 for m in meds if m > 0)) if meds else "")
+        out.append("| **cells pooled** | %s |" % " | ".join(pooled))
+    text = "\n".join(out) + "\n"
+    if a.tables:
+        open(a.tables, "w").write(text)
+    print(text)
+
+
+main()
