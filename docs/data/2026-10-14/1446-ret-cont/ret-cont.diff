+ring_longjmp_mark:
+    svc #0
+    add sp, x12, #0x2000
+    mov x20, x30
+    add x1, x12, #0x100
+    movz x0, #0
+    bl my_setjmp
+    cbnz x0, .Ljumped
+    movz x0, #1
+    bl lj_a
+    movz x5, #0xdead
+.Ljumped:
+    add x6, x0, #7
+    mov x30, x20
+    ret
+
+my_setjmp:
+    mov x2, sp
+    stp x2, x30, [x1]
+    movz x0, #0
+    ret
+
+lj_a:
+    stp x29, x30, [sp, #-16]!
+    add x0, x0, #1
+    bl lj_b
+    ldp x29, x30, [sp], #16
+    ret
+
+lj_b:
+    stp x29, x30, [sp, #-32]!
+    add x0, x0, #2
