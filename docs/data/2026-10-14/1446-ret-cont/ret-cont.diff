+/// EXPERIMENT (exp/ret-cont): the ring push group (`KJIT_RING_PUSH`) of a call whose
+/// resume pc is `cont_pc`.
+fn push_ring_push(
+    out: &mut SharedVec<RephrasedInsn>,
+    original_pc: u64,
+    cont_pc: u64,
+) -> SharedResult<(), SharedAllocError> {
+    for (index, insn) in KJIT_RING_PUSH.iter().enumerate() {
+        let kind = if index == RING_PUSH_ADR_INDEX {
+            RephrasedInsnKind::RingPushAdr { cont_pc }
+        } else {
+            RephrasedInsnKind::RingPush
+        };
+        out.push(
+            RephrasedInsn {
+                kind,
+                ori_pc: original_pc,
+                insn: *insn,
+            },
+            GFP_KERNEL,
+        )?;
+    }
+    Ok(())
+}
+
+/// EXPERIMENT (exp/ret-cont): the ring pop group (`KJIT_RING_POP`).
+fn push_ring_pop(
+    out: &mut SharedVec<RephrasedInsn>,
+    original_pc: u64,
+) -> SharedResult<(), SharedAllocError> {
+    for insn in KJIT_RING_POP.iter() {
+        out.push(
+            RephrasedInsn {
+                kind: RephrasedInsnKind::RingPop,
+                ori_pc: original_pc,
+                insn: *insn,
+            },
+            GFP_KERNEL,
+        )?;
+    }
+    Ok(())
+}
