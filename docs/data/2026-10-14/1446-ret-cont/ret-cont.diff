diff --git a/harness/src/ring_tests.rs b/harness/src/ring_tests.rs
new file mode 100644
index 0000000..e5bba34
--- /dev/null
+++ b/harness/src/ring_tests.rs
@@ -0,0 +1,201 @@
+//! EXPERIMENT (exp/ret-cont): what the return continuations (mode 1) and the shadow
+//! return ring (mode 2) do in the harness, beyond the cold/warm differential every
+//! `tests/arm64/*.s` case already gets in the mode of the process (`$KJIT_RETCONT`).
+//! Each test runs a case of `dispatch_calls.s` / `ring_returns.s` cold and warm in one
+//! explicit mode (compared with the original), then counts what the warm run executed.
+
+use std::path::Path;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use crate::asm_fixture::{compile_case, CompiledCase};
+use crate::cached_run::{compare_cached, new_interpreter_cache, run_cached_differential};
+use crate::code_cache::CodeCache;
+use crate::model::MachineState;
+use crate::runtime::{URuntime, URuntimeConfig, URuntimeStepper};
+use crate::shared::abi::{ring_pop_matches, RING_POP_LEN};
+use crate::shared::trans::retcont::{self, MODE_CONT, MODE_OFF, MODE_RING};
+use crate::case_state;
+
+fn case(fixture: &str, symbol: &str) -> (CompiledCase, MachineState) {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("harness manifest dir has a parent");
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    let out_dir = root.join("tmp").join(format!(
+        "ring-tests.{}.{}.{fixture}.{symbol}",
+        std::process::id(),
+        NEXT.fetch_add(1, Ordering::SeqCst)
+    ));
+    let compiled = compile_case(
+        root,
+        &root.join("tests/arm64").join(format!("{fixture}.s")),
+        symbol,
+        &out_dir,
+    )
+    .unwrap_or_else(|err| panic!("compile {fixture} {symbol}: {err}"));
+    std::fs::remove_dir_all(&out_dir).expect("remove ring test work dir");
+    let state =
+        case_state(symbol, compiled.text_base, &compiled.text_bytes).expect("fixture state");
+    (compiled, state)
+}
+
+/// What a run executed.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct Counts {
+    /// Ring pop groups started: returns that looked at the ring.
+    pop_runs: u64,
+    /// Ring pop groups that branched to a cached host (`br x12` of the group executed).
+    pop_hits: u64,
+    /// Ring push groups executed.
+    push_runs: u64,
+    /// Instructions executed in fragments, over all runtime entries.
+    steps: u64,
+    /// Fragments installed.
+    fragments: usize,
+}
+
+/// The cold and the warm run of a case in `mode`, each equal to the original; the warm
+/// run's counts.
+fn warm_counts(fixture: &str, symbol: &str, mode: u8) -> Counts {
+    retcont::with_mode(mode, || {
+        let (case, state) = case(fixture, symbol);
+        let mut cache = new_interpreter_cache(case.text_base, &case.text_bytes);
+        for phase in ["cold", "warm"] {
+            let (run, next) = run_cached_differential(
+                cache,
+                case.text_base,
+                &case.text_bytes,
+                case.entry_pc,
+                &state,
+            )
+            .unwrap_or_else(|err| panic!("{fixture} {symbol} mode {mode} {phase}: {err}"));
+            compare_cached(phase, &run)
+                .unwrap_or_else(|mismatch| panic!("{fixture} {symbol} mode {mode}: {}", mismatch.message));
+            cache = next;
+        }
+        count_run(cache, &case, &state)
+    })
+}
+
+/// Runs the case once more over `cache` and counts the executions of the ring groups'
+/// first and last words, found by their exact words in every fragment.
+fn count_run(cache: CodeCache, case: &CompiledCase, state: &MachineState) -> Counts {
+    let entry = cache
+        .fragment_for_entry(case.entry_pc)
+        .expect("the cold run translated the entry");
+    // (fragment, instruction index) of every group's first / last word.
+    let mut pop_starts = std::collections::BTreeSet::new();
+    let mut pop_ends = std::collections::BTreeSet::new();
+    let mut push_starts = std::collections::BTreeSet::new();
+    for (index, frag) in cache.fragments.iter().enumerate() {
+        let words: Vec<u32> = frag.fragment.insns.iter().map(|i| i.encode().unwrap()).collect();
+        for start in 0..words.len().saturating_sub(RING_POP_LEN - 1) {
+            if ring_pop_matches(&words[start..start + RING_POP_LEN]) {
+                pop_starts.insert((index, start));
+                pop_ends.insert((index, start + RING_POP_LEN - 1));
+            }
+        }
+        for start in 0..words.len().saturating_sub(4) {
+            if crate::shared::abi::ring_push_matches(&words[start..start + 5]).is_some() {
+                push_starts.insert((index, start));
+            }
+        }
+    }
+    let fragments = cache.fragments.len();
+    let mut runtime = URuntime::with_cache(cache, entry, state.clone(), URuntimeConfig::default());
+    let mut counts = Counts { fragments, ..Counts::default() };
+    let mut stepper = URuntimeStepper::new(&mut runtime).expect("stepper");
+    while let Some(step) = stepper.advance().expect("advance") {
+        if step.executed {
+            counts.steps += 1;
+            if let Some(offset) = step.offset {
+                let at = (step.fragment, offset / 4);
+                counts.pop_runs += u64::from(pop_starts.contains(&at));
+                counts.pop_hits += u64::from(pop_ends.contains(&at));
+                counts.push_runs += u64::from(push_starts.contains(&at));
+            }
+        }
+        if step.halt.is_some() {
+            break;
+        }
+    }
+    counts
+}
+
+#[test]
+fn modes_0_and_1_have_no_ring() {
+    for mode in [MODE_OFF, MODE_CONT] {
+        let counts = warm_counts("ring_returns", "ring_loop_mark", mode);
+        assert_eq!((counts.pop_runs, counts.push_runs), (0, 0), "mode {mode}");
+    }
+}
+
+/// The common case: every return of a call/return loop finds its entry.
+#[test]
+fn a_loop_of_calls_returns_through_the_ring() {
+    let counts = warm_counts("ring_returns", "ring_loop_mark", MODE_RING);
+    // 300 iterations x (bump, bump2, bump inside bump2) = 900 returns, plus the final one.
+    assert!(counts.pop_runs >= 900, "{counts:?}");
+    assert_eq!(counts.pop_hits, counts.pop_runs - 1, "{counts:?}");
+    assert!(counts.push_runs >= 900, "{counts:?}");
+}
+
+#[test]
+fn deep_recursion_overflows_the_ring_and_stays_exact() {
+    let counts = warm_counts("ring_returns", "ring_deep_recursion_mark", MODE_RING);
+    // Sixty-one returns of `deep` and the final one; all the recursive ones share a
+    // resume pc, so even entries overwritten by deeper calls match.
+    assert!(counts.pop_runs >= 61, "{counts:?}");
+    assert!(counts.pop_hits >= 60, "{counts:?}");
+}
+
+/// Returns that must fall back: the pop group runs and does not branch.
+#[test]
+fn mismatched_returns_fall_back_to_the_template() {
+    for symbol in [
+        "ring_longjmp_mark",
+        "ring_alias_mark",
+        "ring_modified_lr_mark",
+        "ring_coroutine_mark",
+    ] {
+        let counts = warm_counts("ring_returns", symbol, MODE_RING);
+        assert!(counts.pop_runs > counts.pop_hits, "{symbol}: {counts:?}");
+        assert!(counts.pop_hits > 0 || symbol != "ring_alias_mark", "{symbol}: {counts:?}");
+    }
+}
+
+/// The empty ring entry (pc 0, host 0) must not match a return to 0: every case ends in
+/// a `ret` to x30 = 0, and the run ends in userspace there, not in a branch to host 0.
+#[test]
+fn a_return_to_zero_does_not_match_an_empty_entry() {
+    for fixture_symbol in [("dispatch_calls", "tail_calls_mark"), ("dispatch_recursion", "recursion_budget_mark")] {
+        warm_counts(fixture_symbol.0, fixture_symbol.1, MODE_RING);
+    }
+}
+
+/// Every case of `dispatch_calls.s` and `ring_returns.s`, all three modes.
+#[test]
+fn the_call_cases_are_exact_in_every_mode() {
+    for (fixture, symbols) in [
+        ("dispatch_calls", &["nested_calls_mark", "tail_calls_mark", "recursion_frames_mark"][..]),
+        (
+            "ring_returns",
+            &[
+                "ring_longjmp_mark",
+                "ring_deep_recursion_mark",
+                "ring_alias_mark",
+                "ring_tail_call_mark",
+                "ring_modified_lr_mark",
+                "ring_coroutine_mark",
+                "ring_blr_mark",
+                "ring_loop_mark",
+            ][..],
+        ),
+    ] {
+        for symbol in symbols {
+            for mode in [MODE_OFF, MODE_CONT, MODE_RING] {
+                warm_counts(fixture, symbol, mode);
+            }
+        }
+    }
+}
