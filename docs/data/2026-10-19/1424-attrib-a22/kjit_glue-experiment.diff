+/* EXPERIMENT: kjit_call_fragment_raw() with the run timed and the msr pan amplifier. */
+static u64 x_call(struct pt_regs *regs, u64 *extra, u64 entry, u64 base, bool fp)
+{
+	u64 t0 = 0, t1, status;
+	bool timed = x_timed();
+
+	if (READ_ONCE(x_rep_pan))
+		x_amp_pan();
+	if (READ_ONCE(x_rep_tramp))
+		x_amp_tramp(regs);
+	if (timed)
+		t0 = arch_timer_read_counter();
+	status = kjit_call_fragment_raw(regs, extra, entry, base);
+	if (timed) {
+		t1 = arch_timer_read_counter();
+		if (fp)
+			x_obs(AT_FFP_T, AT_FFP_N, t1 - t0);
+		else
+			x_obs(AT_FNOFP_T, AT_FNOFP_N, t1 - t0);
+		if (!x_nruns)
+			x_obs(AT_PREP_T, AT_PREP_N, t0 - x_hook_t0);
+		else
+			x_obs(AT_CHAIN_T, AT_CHAIN_N, t0 - x_runend);
+		x_nruns++;
+		x_runend = t1;
+	}
+	return status;
+}
