+/* ========================================================================= */
+/* EXPERIMENT (exp/attrib-a22), never merged: attribution instrumentation.     */
+/*                                                                             */
+/* Everything is off by default (debugfs files x_*), so the module behaves as  */
+/* the A22 module unless a knob is written:                                    */
+/*  - timers (x_pid = tid): CNTVCT time of the hook, of fragment runs (plain   */
+/*    and inside the FP/SIMD bracket), of the bracket, and of the gaps between */
+/*    hook calls of that thread (x_timers, "reset" clears);                    */
+/*  - ablations that change cost, not semantics:                               */
+/*    x_svcnative=1  an SVC exit returns to EL0 and the SVC runs natively      */
+/*                   (the svc_declined path): the fragment code still runs in  */
+/*                   the kernel, only the syscall entry/exit is paid again;    */
+/*    x_decline=1|2  the hook runs kjit_can_run (1) and kjit_lookup (2) and    */
+/*                   then returns to EL0: the hook infrastructure with all     */
+/*                   user code native;                                         */
+/*  - amplifiers (pure, side-effect-free repeats of one operation, N times     */
+/*    per hook call / fragment run / bracket): the slope of server CPU in N    */
+/*    is the in-situ cost of that operation: x_rep_canrun, x_rep_lookup,       */
+/*    x_rep_srcu (per hook call), x_rep_pan (per fragment run: msr pan pair),  */
+/*    x_rep_brk (per bracket: kernel_neon_begin/load/save/end);                */
+/*    x_rep_tramp (per fragment run: the asm trampoline around a stub that     */
+/*    returns at once: NZCV load/store, PAN pair, blr, frame);                 */
+/*    micro boots only (they repeat a run on a copy of pt_regs, so the         */
+/*    fragment must be pure, e.g. a getppid loop): x_rep_call (per hook call:  */
+/*    the real fragment run, trampoline + prologue + body + epilogue),         */
+/*    x_rep_run (per hook call: the whole kjit_rs_after_syscall);              */
+/*  - x_delay=N: a busy loop of N iterations (about 0.3 ns each) at the start of */
+/*    every hook call, KJIT enabled or not: slows the server by a known amount */
+/*    in either state (dose-response of the scheduling effect);               */
+/*  - x_micro: hot-loop ns of the same operations, x_frags: fragment list.     */
+/* ========================================================================= */
+
+enum {
+	AT_HOOK_T, AT_HOOK_N,	/* inside kjit_after_syscall, KJIT enabled */
+	AT_FNOFP_T, AT_FNOFP_N,	/* fragment run outside the bracket */
+	AT_FFP_T, AT_FFP_N,	/* fragment run inside the FP/SIMD bracket */
+	AT_BRK_T, AT_BRK_N,	/* the whole bracket call */
+	AT_GSYS_T, AT_GSYS_N,	/* hook returned a syscall number -> next hook entry */
+	AT_GUSR_T, AT_GUSR_N,	/* hook returned to EL0 (or KJIT off) -> next hook entry */
+	AT_IDLE_T, AT_IDLE_N,	/* gaps over X_IDLE_TICKS (blocked in a syscall) */
+	AT_PREP_T, AT_PREP_N,	/* hook entry (after the gap bookkeeping) -> start of the first fragment run */
+	AT_CHAIN_T, AT_CHAIN_N,	/* end of a run -> start of the next run of the same hook call (a chained entry) */
+	AT_POST_T, AT_POST_N,	/* end of the last run -> hook return */
+	AT_N
+};
+#define X_IDLE_TICKS (1U << 15)	/* 1.36 ms at 24 MHz: a gap this long is a blocked server */
+
+struct x_pcpu {
+	u64 v[AT_N];
+	/* gaps by the syscall that just completed: [0] gsys, [1] gusr; nr 22, 63, 64, other */
+	u64 nr_t[2][4];
+	u64 nr_n[2][4];
+};
+static DEFINE_PER_CPU(struct x_pcpu, x_pc);
+static u32 x_pid;		/* thread id whose hook calls are timed; 0 = none */
+static u64 x_hook_t0, x_runend;	/* start of the timed hook call, end of its last fragment run */
+static u32 x_nruns;		/* fragment runs so far in the timed hook call */
+static u64 x_last_exit;		/* only written by that thread */
+static long x_last_ret = -1;
+static bool x_svcnative;
+static u32 x_decline, x_rep_canrun, x_rep_lookup, x_rep_srcu, x_rep_pan, x_rep_brk, x_rep_atomic;
+static u32 x_rep_tramp, x_rep_call, x_rep_run;
+static u32 x_rep_link, x_rep_clookup;
+static u32 x_nostats;	/* 1: the runtime's counter updates are skipped (Rust), 2: hook_calls per-CPU add, 4: the bracket's two CNTVCT reads */
+static u32 x_delay;	/* busy-loop iterations per hook call, before the enabled check (on and off alike) */
+static atomic64_t x_atom = ATOMIC64_INIT(0);
+DEFINE_STATIC_SRCU(x_srcu);
+
+static inline bool x_timed(void)
+{
+	u32 pid = READ_ONCE(x_pid);
+
+	return pid && (u32)current->pid == pid;
+}
+
+static inline void x_obs(int t, int n, u64 ticks)
+{
+	if ((t == AT_GSYS_T || t == AT_GUSR_T) && ticks > X_IDLE_TICKS) {
+		this_cpu_add(x_pc.v[AT_IDLE_T], ticks);
+		this_cpu_inc(x_pc.v[AT_IDLE_N]);
+		return;
+	}
+	this_cpu_add(x_pc.v[t], ticks);
+	this_cpu_inc(x_pc.v[n]);
+}
+
+static inline void x_nr(int kind, int nr, u64 ticks)
+{
+	int i = nr == 22 ? 0 : nr == 63 ? 1 : nr == 64 ? 2 : 3;
+
+	if (ticks > X_IDLE_TICKS)
+		return;
+	this_cpu_add(x_pc.nr_t[kind][i], ticks);
+	this_cpu_inc(x_pc.nr_n[kind][i]);
+}
+
+static int kjit_copy_cmd(char *buf, size_t size, const char __user *ubuf, size_t count);
+
+static void x_reset(void)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		memset(per_cpu_ptr(&x_pc, cpu), 0, sizeof(struct x_pcpu));
+	x_last_exit = 0;
+	x_last_ret = -1;
+}
+
+static ssize_t x_timers_read(struct file *file, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	static const char *const names[AT_N] = {
+		"hook_t", "hook_n", "fnofp_t", "fnofp_n", "ffp_t", "ffp_n", "brk_t", "brk_n",
+		"gsys_t", "gsys_n", "gusr_t", "gusr_n", "idle_t", "idle_n", "prep_t", "prep_n", "chain_t", "chain_n",
+		"post_t", "post_n",
+	};
+	size_t size = PAGE_SIZE, len = 0;
+	u64 sum[AT_N] = {};
+	char *buf = kmalloc(size, GFP_KERNEL);
+	ssize_t ret;
+	int cpu, i, b;
+
+	if (!buf)
+		return -ENOMEM;
+	for_each_possible_cpu(cpu) {
+		struct x_pcpu *pc = per_cpu_ptr(&x_pc, cpu);
+
+		for (i = 0; i < AT_N; i++)
+			sum[i] += pc->v[i];
+	}
+	len += scnprintf(buf + len, size - len, "cntfrq %u\n", arch_timer_get_cntfrq());
+	for (i = 0; i < 2; i++) {
+		u64 t[4] = {}, nn[4] = {};
+
+		for_each_possible_cpu(cpu)
+			for (b = 0; b < 4; b++) {
+				t[b] += per_cpu_ptr(&x_pc, cpu)->nr_t[i][b];
+				nn[b] += per_cpu_ptr(&x_pc, cpu)->nr_n[i][b];
+			}
+		len += scnprintf(buf + len, size - len,
+				 "%s_by_nr epoll_pwait %llu %llu read %llu %llu write %llu %llu other %llu %llu\n",
+				 i ? "gusr" : "gsys", t[0], nn[0], t[1], nn[1], t[2], nn[2], t[3], nn[3]);
+	}
+	for (i = 0; i < AT_N; i++)
+		len += scnprintf(buf + len, size - len, "%s %llu\n", names[i], sum[i]);
+	ret = simple_read_from_buffer(ubuf, count, ppos, buf, len);
+	kfree(buf);
+	return ret;
+}
+
+static ssize_t x_timers_write(struct file *file, const char __user *ubuf, size_t count, loff_t *ppos)
+{
+	char buf[16];
+	int ret = kjit_copy_cmd(buf, sizeof(buf), ubuf, count);
+
+	if (ret)
+		return ret;
+	if (strcmp(strim(buf), "reset"))
+		return -EINVAL;
+	x_reset();
+	return count;
+}
+
+static const struct file_operations x_timers_fops = {
+	.owner = THIS_MODULE,
+	.read = x_timers_read,
+	.write = x_timers_write,
+};
+
+/* Amplifier sink: keeps the repeated pure operations from being optimized away. */
+static inline void x_sink(u64 v)
+{
+	asm volatile("" : : "r"(v));
+}
+
+/* The amplified per-hook-call operations. */
+static noinline void x_amp_hook(struct pt_regs *regs)
+{
+	u32 i, n;
+	u64 entry = 0;
+
+	n = READ_ONCE(x_rep_canrun);
+	for (i = 0; i < n; i++)
+		x_sink(kjit_can_run(regs));
+	n = READ_ONCE(x_rep_lookup);
+	for (i = 0; i < n; i++)
+		x_sink((u64)kjit_lookup(regs->pc, false, &entry));
+	n = READ_ONCE(x_rep_srcu);
+	for (i = 0; i < n; i++) {
+		int idx = srcu_read_lock(&x_srcu);
+
+		srcu_read_unlock(&x_srcu, idx);
+	}
+	n = READ_ONCE(x_rep_atomic);
+	for (i = 0; i < n; i++)
+		atomic64_add(1, &x_atom);	/* the runtime's stats counters are global relaxed atomics */
+}
+
+/* Stub the trampoline amplifier calls instead of a fragment base: returns at once. */
+static noinline u64 x_stub(void)
+{
+	return 0;
+}
+
+/* @n round trips through the asm trampoline into x_stub (in a run, around the real one). */
+static noinline void x_amp_tramp(struct pt_regs *regs)
+{
+	struct pt_regs tmp = *regs;
+	u64 extra[3] = {};
+	u32 i, n = READ_ONCE(x_rep_tramp);
+
+	for (i = 0; i < n; i++)
+		x_sink(kjit_call_fragment_raw(&tmp, extra, 0, (u64)x_stub));
+}
+
+/* Micro boots: @n real runs of the fragment for regs->pc on a copy of pt_regs (pure fragments only). */
+static noinline void x_amp_call(struct pt_regs *regs)
+{
+	struct pt_regs tmp;
+	u64 entry = 0, extra[3] = {};
+	struct kjit_frag *f = kjit_lookup(regs->pc, false, &entry);
+	u32 i, n = READ_ONCE(x_rep_call);
+
+	if (!f || kjit_frag_uses_fpsimd(f))
+		return;
+	extra[2] = kjit_frag_table(f);
+	for (i = 0; i < n; i++) {
+		tmp = *regs;
+		x_sink(kjit_call_fragment_raw(&tmp, extra, entry, kjit_frag_base(f)));
+	}
+}
+
+/* Micro boots: @n whole hook bodies on a copy of pt_regs (the syscall they return is not invoked). */
+static noinline void x_amp_run(struct pt_regs *regs)
+{
+	struct pt_regs tmp;
+	u32 i, n = READ_ONCE(x_rep_run);
+
+	for (i = 0; i < n; i++) {
+		tmp = *regs;
+		x_sink(kjit_rs_after_syscall(&tmp));
+	}
+}
+
+static noinline void x_amp_pan(void)
+{
+	u32 i, n = READ_ONCE(x_rep_pan);
+
+	for (i = 0; i < n; i++) {
+		asm volatile(SET_PSTATE_PAN(0) ::: "memory");
+		asm volatile(SET_PSTATE_PAN(1) ::: "memory");
+	}
+}
+
+/* One bracket's setup and teardown without a fragment run in between. */
+static noinline void x_bracket_once(void)
+{
+	struct user_fpsimd_state kbuf;
+	struct user_fpsimd_state *uw = &current->thread.uw.fpsimd_state;
+
+	kernel_neon_begin(&kbuf);
+	fpsimd_load_state(uw);
+	pagefault_disable();
+	pagefault_enable();
+	preempt_disable();
+	fpsimd_save_state(uw);
+	current->thread.fpsimd_cpu = NR_CPUS;
+	barrier();
+	kernel_neon_end(&kbuf);
+	preempt_enable();
+}
+
+static noinline void x_amp_brk(void)
+{
+	u32 i, n = READ_ONCE(x_rep_brk);
+
+	for (i = 0; i < n; i++)
+		x_bracket_once();
+}
+
+/* Hot-loop cost of the same operations, ns per operation (x_micro). */
+static ssize_t x_micro_read(struct file *file, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	char buf[640];
+	struct pt_regs *regs = task_pt_regs(current);
+	u64 t0, t1, t2, t3, t4, t5, t6, t7, t8, ent = 0, hz = arch_timer_get_cntfrq();
+	u32 i;
+	size_t len;
+
+	if (!kjit_fpsimd_supported())
+		return -EOPNOTSUPP;
+	t0 = ktime_get_ns();
+	for (i = 0; i < 1000000; i++)
+		x_sink(kjit_can_run(regs));
+	t1 = ktime_get_ns();
+	for (i = 0; i < 1000000; i++) {
+		int idx = srcu_read_lock(&x_srcu);
+
+		srcu_read_unlock(&x_srcu, idx);
+	}
+	t2 = ktime_get_ns();
+	for (i = 0; i < 1000000; i++) {
+		asm volatile(SET_PSTATE_PAN(0) ::: "memory");
+		asm volatile(SET_PSTATE_PAN(1) ::: "memory");
+	}
+	t3 = ktime_get_ns();
+	for (i = 0; i < 100000; i++)
+		x_bracket_once();
+	t4 = ktime_get_ns();
+	for (i = 0; i < 1000000; i++)
+		x_sink(arch_timer_read_counter());
+	t5 = ktime_get_ns();
+	for (i = 0; i < 1000000; i++)
+		this_cpu_inc(x_pc.v[AT_IDLE_N]);
+	t6 = ktime_get_ns();
+	for (i = 0; i < 1000000; i++)
+		x_sink((u64)kjit_lookup(0, false, &ent));
+	t7 = ktime_get_ns();
+	for (i = 0; i < 1000000; i++)
+		atomic64_add(1, &x_atom);
+	t8 = ktime_get_ns();
+	len = scnprintf(buf, sizeof(buf),
+			"cntfrq %llu can_run_ps %llu srcu_pair_ps %llu pan_pair_ps %llu bracket_ps %llu "
+			"cntvct_read_ps %llu percpu_inc_ps %llu lookup_miss_ps %llu atomic_add_ps %llu\n",
+			hz, (t1 - t0) / 1000, (t2 - t1) / 1000, (t3 - t2) / 1000,
+			(t4 - t3) / 100, (t5 - t4) / 1000, (t6 - t5) / 1000,
+			(t7 - t6) / 1000, (t8 - t7) / 1000);
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static const struct file_operations x_micro_fops = {
+	.owner = THIS_MODULE,
+	.read = x_micro_read,
+};
+
+/* Fragment list, text: "F <image address> <entry pc> <code_len> <uses_fpsimd> <src_start> <src_end>". */
+static int x_frags_open(struct inode *inode, struct file *file)
+{
+	char *buf;
+	struct kjit_frag *f;
+	size_t cap = 1 << 20, len = 0;
+
+	buf = kvmalloc(cap, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	spin_lock(&kjit_frags_lock);
+	list_for_each_entry(f, &kjit_all_frags, all_node) {
+		if (len + 128 > cap)
+			break;
+		len += scnprintf(buf + len, cap - len, "F %llx %llx %u %d %llx %llx\n", (u64)f->image,
+				 f->entry_pc, f->code_len, f->uses_fpsimd, f->src_start, f->src_end);
+	}
+	spin_unlock(&kjit_frags_lock);
+	file->private_data = buf;
+	((char *)buf)[len] = '\0';
+	return 0;
+}
+
+static ssize_t x_frags_read(struct file *file, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	char *buf = file->private_data;
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, strlen(buf));
+}
+
+static int x_frags_release(struct inode *inode, struct file *file)
+{
+	kvfree(file->private_data);
+	return 0;
+}
+
+static const struct file_operations x_frags_fops = {
+	.owner = THIS_MODULE,
+	.open = x_frags_open,
+	.read = x_frags_read,
+	.release = x_frags_release,
+	.llseek = default_llseek,
+};
