+/*
+ * EXPERIMENT (exp/attrib-a17): x_nop ablation. Replaces the words of one class of
+ * runtime-owned checks by NOPs in the image copy (same size, so labels, sites, links and
+ * the extable stay valid; the verifier saw the unpatched bytes). For the benchmark only:
+ * a check that would have fired no longer does. Classes (mask x_nop, writable only with
+ * KJIT disabled; a write flushes every fragment and waits for their retirement, so the
+ * next translations are installed patched):
+ *   1 budget  `sub x18, x18, #1; cbz x18`
+ *   2 range   `ubfx xB, xA, #48, #8; cbnz xB, <Mem stub>`
+ *   4 align   `and xS, x17, #15; cbnz xS, <Mem stub>` and the acquire/release form
+ *             `and xS, xN, #15; add xS, xS, #k; and xS, xS, #16; cbnz xS, <Mem stub>`
+ * Range and align words are only taken when the cbnz targets a Mem stub of the fragment
+ * (the fault-site list), so user code with the same shapes is never touched.
+ */
+#define X_NOP_BUDGET 1
+#define X_NOP_RANGE 2
+#define X_NOP_ALIGN 4
+#define X_NOP_WORD 0xd503201fU
+static u32 x_nop;
+static u64 x_nop_patched[3];
+
+static inline u32 x_w(const u8 *code, u32 i)
+{
+	return le32_to_cpup((const __le32 *)(code + 4 * i));
+}
+
+static inline void x_set(u8 *code, u32 i)
+{
+	*(__le32 *)(code + 4 * i) = cpu_to_le32(X_NOP_WORD);
+}
+
+static bool x_cbnz_to_stub(const u8 *code, u32 i, u32 nwords, const struct kjit_site *sites, u32 n_sites, u32 *rt)
+{
+	u32 w = x_w(code, i), off, k;
+	s32 imm19;
+
+	if ((w & 0xff000000) != 0xb5000000)
+		return false;
+	imm19 = sign_extend32((w >> 5) & 0x7ffff, 18);
+	if ((s64)i + imm19 < 0 || (s64)i + imm19 >= nwords)
+		return false;
+	off = 4 * (i + imm19);
+	for (k = 0; k < n_sites; k++)
+		if (sites[k].stub == off) {
+			*rt = w & 31;
+			return true;
+		}
+	return false;
+}
+
+static void x_patch(u8 *code, u32 nwords, const struct kjit_site *sites, u32 n_sites)
+{
+	u32 mask = READ_ONCE(x_nop), i, rt;
+
+	for (i = 0; i < nwords; i++) {
+		u32 w = x_w(code, i);
+
+		if ((mask & X_NOP_BUDGET) && w == 0xd1000652 && i + 1 < nwords &&
+		    (x_w(code, i + 1) & 0xff00001f) == 0xb4000012) {
+			x_set(code, i);
+			x_set(code, i + 1);
+			x_nop_patched[0] += 2;
+			continue;
+		}
+		if (!(mask & (X_NOP_RANGE | X_NOP_ALIGN)) || !i ||
+		    !x_cbnz_to_stub(code, i, nwords, sites, n_sites, &rt))
+			continue;
+		w = x_w(code, i - 1);
+		if ((mask & X_NOP_RANGE) && (w & 0xfffffc00) == 0xd370dc00 && (w & 31) == rt) {
+			x_set(code, i - 1);
+			x_set(code, i);
+			x_nop_patched[1] += 2;
+		} else if ((mask & X_NOP_ALIGN) && w == (0x92400e20 | rt)) {
+			/* and xS, x17, #15 (SP base) */
+			x_set(code, i - 1);
+			x_set(code, i);
+			x_nop_patched[2] += 2;
+		} else if ((mask & X_NOP_ALIGN) && i >= 3 && (w & 0xffffffff) == (0x927c0000 | (rt << 5) | rt) &&
+			   (x_w(code, i - 2) & 0xffc003ff) == (0x91000000 | (rt << 5) | rt) &&
+			   (x_w(code, i - 3) & 0xfffffc1f) == (0x92400c00 | rt)) {
+			x_set(code, i - 3);
+			x_set(code, i - 2);
+			x_set(code, i - 1);
+			x_set(code, i);
+			x_nop_patched[2] += 4;
+		}
+	}
+}
+
+static int x_nop_get(void *data, u64 *val)
+{
+	*val = READ_ONCE(x_nop);
+	return 0;
+}
+
+static int x_nop_set(void *data, u64 val)
+{
+	struct kjit_mm *kmm;
+	unsigned int bkt;
+	bool any;
+	u64 n = 0;
+
+	if (val & ~(u64)(X_NOP_BUDGET | X_NOP_RANGE | X_NOP_ALIGN))
+		return -EINVAL;
+	if (READ_ONCE(kjit_enabled))
+		return -EBUSY;
+	rcu_read_lock();
+	hash_for_each_rcu(kjit_mm_hash, bkt, kmm, hash_node) {
+		spin_lock(&kmm->lock);
+		kmm->seq++;
+		n += kjit_mm_flush_locked(kmm, 0, ULONG_MAX);
+		spin_unlock(&kmm->lock);
+	}
+	rcu_read_unlock();
+	if (n)
+		kjit_rs_note(KJIT_NOTE_INVALIDATED, n);
+	kjit_hook_srcu_barrier();
+	rcu_barrier();
+	flush_workqueue(kjit_wq);
+	spin_lock(&kjit_frags_lock);
+	any = !list_empty(&kjit_all_frags);
+	spin_unlock(&kjit_frags_lock);
+	if (any)
+		return -EBUSY;
+	WRITE_ONCE(x_nop, val);
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(x_nop_fops, x_nop_get, x_nop_set, "%llu\n");
