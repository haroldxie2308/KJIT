+/* ------------------------------------------------------------------------- */
+/* EXPERIMENT (exp/huge-arena, never merged): 4 KiB / PMD arena chunk switch    */
+
+/*
+ * exp_huge selects the next chunk's mapping: 0 = A17's execmem allocation of
+ * 4 KiB pages, 1 = one PMD block, 2 = control: 4 KiB pages, 2 MiB-aligned, ROX from the start. It changes only with KJIT disabled: every
+ * fragment of every mm is dropped (seq++ so a translation in flight cannot
+ * install), the retirements and image frees are waited for, and a chunk that is
+ * left makes the write fail with -EBUSY. Like exp_img of exp/rox-rwx, so modes
+ * pair inside one boot.
+ */
+static int exp_huge_set(void *data, u64 val)
+{
+	struct kjit_mm *kmm;
+	unsigned int bkt;
+	bool any;
+	u64 n = 0;
+
+	if (val > 2)
+		return -EINVAL;
+	if (READ_ONCE(kjit_enabled))
+		return -EBUSY;
+	rcu_read_lock();
+	hash_for_each_rcu(kjit_mm_hash, bkt, kmm, hash_node) {
+		spin_lock(&kmm->lock);
+		kmm->seq++;
+		n += kjit_mm_flush_locked(kmm, 0, ULONG_MAX);
+		spin_unlock(&kmm->lock);
+	}
+	rcu_read_unlock();
+	if (n)
+		kjit_rs_note(KJIT_NOTE_INVALIDATED, n);
+	kjit_hook_srcu_barrier();
+	rcu_barrier();
+	flush_workqueue(kjit_wq);
+	spin_lock(&kjit_frags_lock);
+	any = !list_empty(&kjit_all_frags);
+	spin_unlock(&kjit_frags_lock);
+	if (any || atomic_long_read(&kjit_arena_nchunks))
+		return -EBUSY;
+	WRITE_ONCE(exp_huge, val);
+	return 0;
+}
+
+static int exp_huge_get(void *data, u64 *val)
+{
+	*val = READ_ONCE(exp_huge);
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(exp_huge_fops, exp_huge_get, exp_huge_set, "%llu\n");
