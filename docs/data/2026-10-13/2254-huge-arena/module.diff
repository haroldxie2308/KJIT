+/*
+ * Page-table evidence per arena chunk: how the 512 4 KiB pages of its vmalloc
+ * alias are mapped (PMD leaf, PTE, PTE_CONT), whether they are one physically
+ * contiguous 2 MiB-aligned run, the attribute bits of the first page's
+ * descriptor, and how the linear-map alias of every page is mapped and whether
+ * it is read-only.
+ */
+static int exp_chunks_show(struct seq_file *m, void *unused)
+{
+	struct kjit_arena_chunk *c;
+	unsigned int nchunks = 0;
+
+	mutex_lock(&kjit_arena_lock);
+	list_for_each_entry(c, &kjit_arena_chunks, node) {
+		unsigned int vm_pmd = 0, vm_pte = 0, vm_cont = 0, contig = 0, lm_blk = 0, lm_pte = 0,
+			     lm_ro = 0, lm_cont = 0, i;
+		unsigned long pfn0 = 0;
+		u64 d0 = 0;
+		int l0 = 0;
+		bool c0 = false;
+
+		for (i = 0; i < KJIT_ARENA_CHUNK / PAGE_SIZE; i++) {
+			unsigned long va = (unsigned long)c->base + (unsigned long)i * PAGE_SIZE;
+			struct page *pg = vmalloc_to_page((void *)va);
+			int vl, ll;
+			bool vc, lc;
+			u64 vv = exp_walk(va, &vl, &vc);
+			u64 lv = exp_walk((unsigned long)page_address(pg), &ll, &lc);
+
+			if (!i) {
+				d0 = vv;
+				l0 = vl;
+				c0 = vc;
+				pfn0 = page_to_pfn(pg);
+			}
+			if (page_to_pfn(pg) == pfn0 + i)
+				contig++;
+			if (vl == 2)
+				vm_pmd++;
+			else if (vl == 3)
+				vm_pte++;
+			if (vc && vl == 3)
+				vm_cont++;
+			if (ll == 2)
+				lm_blk++;
+			else if (ll == 3)
+				lm_pte++;
+			if (lc)
+				lm_cont++;
+			if (lv & PTE_RDONLY)
+				lm_ro++;
+		}
+		seq_printf(m, "chunk %px huge %u va_align_2m %u pa0 %lx pa_align_2m %u pfn_contig_pages %u first_level %d first_cont %d first_desc %016llx vm_pmd_pages %u vm_pte_pages %u vm_cont_pages %u lm_alias_block_pages %u lm_alias_pte_pages %u lm_alias_cont_pages %u lm_alias_ro_pages %u\n",
+			   c->base, c->huge, IS_ALIGNED((unsigned long)c->base, SZ_2M),
+			   pfn0 << PAGE_SHIFT, IS_ALIGNED(pfn0 << PAGE_SHIFT, SZ_2M), contig, l0, c0,
+			   d0, vm_pmd, vm_pte, vm_cont, lm_blk, lm_pte, lm_cont, lm_ro);
+		nchunks++;
+	}
+	mutex_unlock(&kjit_arena_lock);
+	seq_printf(m, "chunks %u exp_huge %u vmalloc %lx-%lx\n", nchunks, READ_ONCE(exp_huge),
+		   (unsigned long)VMALLOC_START, (unsigned long)VMALLOC_END);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(exp_chunks);
