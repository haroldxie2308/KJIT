+/* init_mm is not exported: the kernel tables are TTBR1's (swapper_pg_dir, KPTI on or off). */
+static pgd_t *exp_pgd_k(unsigned long addr)
+{
+	pgd_t *base = __va(read_sysreg(ttbr1_el1) & GENMASK_ULL(47, 12));
+
+	return base + pgd_index(addr);
+}
+
+/* Walks the kernel tables for @addr: returns the leaf value, its level (3 pte, 2 pmd, 1 pud), 0 if none. */
+static u64 exp_walk(unsigned long addr, int *level, bool *cont)
+{
+	pgd_t *pgdp = exp_pgd_k(addr);
+	p4d_t *p4dp;
+	pud_t *pudp, pud;
+	pmd_t *pmdp, pmd;
+	pte_t *ptep, pte;
+
+	*level = 0;
+	*cont = false;
+	if (pgd_none(pgdp_get(pgdp)))
+		return 0;
+	p4dp = p4d_offset(pgdp, addr);
+	if (p4d_none(p4dp_get(p4dp)))
+		return 0;
+	pudp = pud_offset(p4dp, addr);
+	pud = pudp_get(pudp);
+	if (pud_none(pud))
+		return 0;
+	if (pud_leaf(pud)) {
+		*level = 1;
+		return pud_val(pud);
+	}
+	pmdp = pmd_offset(pudp, addr);
+	pmd = pmdp_get(pmdp);
+	if (pmd_none(pmd))
+		return 0;
+	if (pmd_leaf(pmd)) {
+		*level = 2;
+		*cont = !!(pmd_val(pmd) & PMD_SECT_CONT);
+		return pmd_val(pmd);
+	}
+	ptep = pte_offset_kernel(pmdp, addr);
+	pte = __ptep_get(ptep);
+	*level = 3;
+	*cont = !!(pte_val(pte) & PTE_CONT);
+	return pte_val(pte);
+}
+
+/*
+ * EXPERIMENT: one 2 MiB, 2 MiB-aligned chunk, ROX from the start and mapped by
+ * a single PMD block, or NULL. The pages hold whatever they held (the caller
+ * fills them with BRK through the text patcher). A mapping that is not one
+ * PMD leaf is refused: a chunk that silently fell back to 4 KiB pages would
+ * make the experiment measure the wrong thing.
+ */
+static void *exp_huge_chunk_alloc(u32 mode)
+{
+	int level;
+	bool cont;
+	/*
+	 * mode 1: one PMD block. mode 2 (control): the same allocation without
+	 * VM_ALLOW_HUGE_VMAP, so 4 KiB pages, but 2 MiB-aligned and ROX from the
+	 * start like mode 1, to separate the mapping size from the alignment.
+	 */
+	void *base = __vmalloc_node_range_noprof(KJIT_ARENA_CHUNK, KJIT_ARENA_CHUNK,
+						 VMALLOC_START, VMALLOC_END, GFP_KERNEL,
+						 PAGE_KERNEL_ROX, mode == 1 ? VM_ALLOW_HUGE_VMAP : 0,
+						 NUMA_NO_NODE, __builtin_return_address(0));
+
+	if (!base)
+		return NULL;
+	exp_walk((unsigned long)base, &level, &cont);
+	if (level != (mode == 1 ? 2 : 3) || cont) {
+		pr_err("kjit: exp_huge=%u chunk %px has the wrong mapping (level %d cont %d)\n",
+		       mode, base, level, cont);
+		vfree(base);
+		return NULL;
+	}
+	return base;
+}
